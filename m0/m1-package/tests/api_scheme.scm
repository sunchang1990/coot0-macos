
(define results '())
(define (check name thunk)
  (let ((r (catch #t
             (lambda () (let ((v (thunk))) (list name (if v 'PASS 'FAIL) v)))
             (lambda (key . args) (list name 'FAIL (format #f "EXC ~s ~s" key (if (pair? args) (car args) args)))))))
    (set! results (cons r results))))
(format #t "GUILEVER ~a~%" (version))
(check "command-in-path? finds sh" (lambda () (command-in-path? "sh")))
(check "command-in-path? rejects a missing command" (lambda () (not (command-in-path? "no-such-command-xyz"))))
(check "command-in-path? rejects a directory named like a command"
       (lambda ()
         (let* ((d (string-append "/tmp/coot-pathtest-" (number->string (getpid))))
                (sub (string-append d "/coot-dir-not-a-command"))
                (old-path (getenv "PATH")))
           (mkdir d) (mkdir sub)
           (putenv (string-append "PATH=" d ":" old-path))
           (let ((r (not (command-in-path? "coot-dir-not-a-command"))))
             (putenv (string-append "PATH=" old-path))
             (rmdir sub) (rmdir d)
             r))))
(check "coot-version is string" (lambda () (string? (coot-version))))
(let ((imol (read-pdb (string-append (getenv "COOT_PREFIX") "/test-data/standard-residues.pdb"))))
  (check "read-pdb -> valid imol" (lambda () (and (>= imol 0) (valid-model-molecule? imol))))
  (check "molecule-name is string" (lambda () (string? (molecule-name imol))))
  (check "n-chains" (lambda () (> (n-chains imol) 0)))
  (check "chain-id returns string" (lambda () (string? (chain-id imol 0))))
  (check "residue-name returns string" (lambda () (string? (residue-name imol "A" (seqnum-from-serial-number imol "A" 0) ""))))
  (check "residue-info returns list" (lambda () (list? (residue-info imol "A" (seqnum-from-serial-number imol "A" 0) ""))))
  (check "scheme layer loaded: chain-ids" (lambda () (list? (chain-ids imol))))
  (check "scheme layer: residue-spec->chain-id" (lambda () (equal? (residue-spec->chain-id (list "A" 1 "")) "A")))
  (check "non-ASCII path arg -> -1" (lambda () (= (read-pdb "/nonexistent/\u00e9.pdb") -1)))
  (check "write-pdb-file" (lambda () (begin (write-pdb-file imol (string-append (getenv "COOT_PREFIX") "/work/out_scm.pdb")) #t))))

;; --- guile-compat shim (run / run-with-pipe / run-concurrently / regex / threads / inet-aton) ---
(check "run true -> #t"  (lambda () (eq? #t (run "true"))))
(check "run false -> #f" (lambda () (eq? #f (run "false"))))
(check "run missing program -> #f (no crash)" (lambda () (eq? #f (run "coot-no-such-program-xyz"))))
(check "string-match / match:substring" (lambda () (equal? (match:substring (string-match "a+" "baaab")) "aaa")))
(check "regexp-quote" (lambda () (string? (regexp-quote "a.b"))))
(check "inet-aton" (lambda () (not (not (inet-aton "127.0.0.1")))))
(check "call-with-new-thread + join" (lambda () (let ((t (call-with-new-thread (lambda () 42)))) (= 42 (join-thread t)))))
(check "goosh-command (run-with-pipe r+, cat) status 0" (lambda () (eqv? 0 (goosh-command "cat" '() (list "hello" "world") (string-append (getenv "COOT_PREFIX") "/work/goosh.log") #f))))
(check "goosh-command log has piped data" (lambda () (equal? (call-with-input-file (string-append (getenv "COOT_PREFIX") "/work/goosh.log") (lambda (p) (let loop ((l (read-line p)) (acc '())) (if (eof-object? l) (reverse acc) (loop (read-line p) (cons l acc)))))) '("hello" "world"))))
(check "run-command/strings echo" (lambda () (equal? (run-command/strings "echo" (list "a" "b") '()) '("a b"))))
(check "goosh-command-with-file-input (run honours redirects)" (lambda () (begin (goosh-command-with-file-input "cat" '() (string-append (getenv "COOT_PREFIX") "/tests/goosh_in.txt") (string-append (getenv "COOT_PREFIX") "/work/gwfi.log"))
   (equal? (call-with-input-file (string-append (getenv "COOT_PREFIX") "/work/gwfi.log") (lambda (p) (let loop ((l (read-line p)) (acc '())) (if (eof-object? l) (reverse acc) (loop (read-line p) (cons l acc)))))) '("line one" "line two")))))
(check "command-in-path-or-absolute? cat" (lambda () (command-in-path-or-absolute? "cat")))
(check "command-in-path-or-absolute? missing -> #f" (lambda () (not (command-in-path-or-absolute? "coot-no-such-program-xyz"))))
(for-each (lambda (r) (format #t "~a ~a  ~s~%" (cadr r) (car r) (caddr r))) (reverse results))
(format #t "SUMMARY ~a / ~a~%" (length (filter (lambda (r) (eq? (cadr r) 'PASS)) results)) (length results))
