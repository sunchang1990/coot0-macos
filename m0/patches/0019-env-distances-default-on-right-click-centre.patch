+// macOS port: trackpads (and Magic Mouse) have no middle button.  A still right-click (a two-finger
+// click on a trackpad) acts as a middle-click, i.e. it re-centres on the atom under the pointer.
+// Right-button *drags* are unchanged (zoom).  Set COOT_RIGHT_CLICK_CENTRE=0 to turn this off.
+static bool coot_right_click_centres() {
+   static int state = -1;
+   if (state < 0) {
+      const char *e = getenv("COOT_RIGHT_CLICK_CENTRE");
+      state = (e && (std::string(e) == "0" || std::string(e) == "no" || std::string(e) == "off")) ? 0 : 1;
+   }
+   return state == 1;
+}
