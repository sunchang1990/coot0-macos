 ;; Thank you for this, rixed at happyleptic.org
 (define (command-in-path? f)
-  (let ((path (string-split (getenv "PATH") #\:))
-	(make-absolute (lambda (path) (string-append path "/" f))))
-    (any file-exists? (map make-absolute path))))
+  ;; macOS port: a directory called "reduce" (e.g. <phenix>/build/reduce) in a PATH entry used to
+  ;; count as "the command is there"; require a regular file that can be executed.
+  (let ((path (string-split (or (getenv "PATH") "") #\:))
+	(make-absolute (lambda (path) (string-append path "/" f)))
+	(executable-file? (lambda (fn)
+			    (and (file-exists? fn)
+				 (eq? 'regular (stat:type (stat fn)))
+				 (access? fn X_OK)))))
+    (any executable-file? (map make-absolute path))))
 
 
