diff --git a/coot-utils/coot-coord-utils.cc b/coot-utils/coot-coord-utils.cc
index 2ca89e2..79581d3 100644
--- a/coot-utils/coot-coord-utils.cc
+++ b/coot-utils/coot-coord-utils.cc
@@ -7554,7 +7554,12 @@ coot::write_coords_cif(mmdb::Manager *mol, const std::string &file_name) {
 
    util::remove_wrong_cis_peptides(mol);
    // util::correct_link_distances(mol);  // this duplicates the molecule.  Needs investigation - GetLink()?
-   int r = mol->WriteCIFASCII(file_name.c_str());
+   // macOS port (build 31): write a copy, as coords/mmdb.cc does: WriteCIFASCII() keeps its CIF data in the
+   // Manager, so each further call on the same molecule wrote the loops again (the file grew with every save).
+   mmdb::Manager *mol_copy = new mmdb::Manager;
+   mol_copy->Copy(mol, mmdb::MMDBFCM_All);
+   int r = mol_copy->WriteCIFASCII(file_name.c_str());
+   delete mol_copy;
    return r;
 }
 
