diff --git a/scheme/guile-compat.scm b/scheme/guile-compat.scm
index aae65e2..d92f691 100644
--- a/scheme/guile-compat.scm
+++ b/scheme/guile-compat.scm
@@ -22,27 +22,46 @@
         (if (and (file-port? (current-output-port))) (current-output-port) 1)
         (if (and (file-port? (current-error-port)))  (current-error-port)  2)))
 
+;; macOS port: external programs are started through the C library's system() (via /bin/sh), not through
+;; Guile's fork+exec spawn().  Inside the Cocoa GUI process spawn() children exited with status 127 without
+;; ever running the program (and without any message) -- reduce, probe, refmac... never ran.  With system()
+;; a missing/unrunnable program is reported by the shell on stderr, and redirections are done by the shell.
+
+;; POSIX single-quote a string for /bin/sh
+(define (%sh-quote s)
+  (string-append "'" (string-join (string-split s #\') "'\\''") "'"))
+
+;; "prog arg1 arg2 ..." with every word quoted
+(define (%command-line prog args)
+  (string-join (map %sh-quote (cons prog args)) " "))
+
+;; run a shell command line, wait; the exit status (0-255), or #f if the shell was killed by a signal
+(define (%system-status cmdline)
+  (force-output (current-output-port))
+  (force-output (current-error-port))
+  (status:exit-val (system cmdline)))
+
+;; a fresh temporary file name
+(define (%tmp-file-name suffix)
+  (string-append (or (getenv "TMPDIR") "/tmp") "/coot-" (number->string (getpid)) "-"
+                 (number->string (random 1000000000 (random-state-from-platform))) suffix))
+
 ;; (run prog arg ...) : run PROG (searched for in $PATH) and wait for it.
 ;; Returns #t if the exit status was 0, else #f   (the (os process) semantics the scheme layer relies on).
 (define (run prog . args)
-  (force-output (current-output-port))
-  (let* ((stdio (%child-stdio))
-         (pid (catch 'system-error
-                (lambda () (spawn prog (cons prog args)
-                                  #:input (car stdio) #:output (cadr stdio) #:error (caddr stdio)))
-                (lambda args #f))))
-    (and pid
-         (let ((st (cdr (waitpid pid))))
-           (eqv? 0 (status:exit-val st))))))
+  (eqv? 0 (%system-status (%command-line prog args))))
 
-;; (run-concurrently prog arg ...) : start PROG and do not wait.  Returns the pid (or #f).
+;; (run-concurrently prog arg ...) : start PROG and do not wait.  Returns #t (the (os process) pid is not available).
 (define (run-concurrently prog . args)
-  (force-output (current-output-port))
-  (let ((stdio (%child-stdio)))
-    (catch 'system-error
-      (lambda () (spawn prog (cons prog args)
-                        #:input (car stdio) #:output (cadr stdio) #:error (caddr stdio)))
-      (lambda args #f))))
+  (%system-status (string-append (%command-line prog args) " &"))
+  #t)
+
+;; (run-redirected prog args input-file output-file) : stdin from INPUT-FILE (#f: /dev/null), stdout to OUTPUT-FILE
+;; (#f: Coot's stdout); stderr stays Coot's.  Returns the exit status.
+(define (run-redirected prog args input-file output-file)
+  (%system-status (string-append "exec " (%command-line prog args)
+                                 " < " (%sh-quote (or input-file "/dev/null"))
+                                 (if output-file (string-append " > " (%sh-quote output-file)) ""))))
 
 ;; (run-with-pipe mode prog arg ...) :
 ;;   "r+" -> (pid output-port . input-port)   output-port reads the child's stdout, input-port writes the child's stdin
