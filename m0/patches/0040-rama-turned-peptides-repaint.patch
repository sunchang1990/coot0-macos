+# (build 24) What counts as a flipped peptide.  The user flipped four peptides on purpose (17 Nov): the report named two as flipped, but all four
+# were put back, two of them by the refinement as it is (try A) without any flip try.  The report now compares every peptide with the start of
+# the run: a peptide has turned when its carbonyl O ends up more than rama_flip_turn_angle degrees round the CA(i) - CA(i+1) axis from where it
+# was.  Turned peptides are listed in two groups: flipped by the flip try (try B kept), and turned by the refinement itself.
+rama_flip_turn_angle = 90.0
+
+def peptide_orientations(imol):
+    """{(chain, res_no, alt conf): (CA i, O i, CA i+1)} for every peptide i / i+1 of amino acids joined by a peptide bond."""
+    out = {}
+    if not valid_model_molecule_qm(imol):
+        return out
+    for chain_id in chain_ids(imol) or []:
+        residues = {}
+        for serial in range(chain_n_residues(chain_id, imol)):
+            r = seqnum_from_serial_number(imol, chain_id, serial)
+            if insertion_code_from_serial_number(imol, chain_id, serial) == "":
+                residues[r] = _residue_atoms(imol, chain_id, r)
+        for r, a in residues.items():
+            b = residues.get(r + 1)
+            if not b:
+                continue
+            def get(atoms, name, alt):        # that alt conf, else the shared atom, else the first conformer (a shared O next to a split N)
+                xyz = atoms.get((name, alt)) or atoms.get((name, ""))
+                if xyz:
+                    return xyz
+                others = sorted(k for k in atoms if k[0] == name)
+                return atoms[others[0]] if others else None
+            for (name, alt), o in a.items():
+                if name != "O":
+                    continue
+                ca1, c = get(a, "CA", alt), get(a, "C", alt)
+                ca2, n = get(b, "CA", alt), get(b, "N", alt)
+                if ca1 and ca2 and c and n and sum((c[i] - n[i]) ** 2 for i in range(3)) < 2.5 * 2.5:
+                    out[(chain_id, r, alt)] = (ca1, o, ca2)
+    return out
+
+def peptide_turn_angle(before, after):
+    """Angle (degrees) by which the carbonyl O turned round the CA(i) - CA(i+1) axis between two (CA i, O i, CA i+1) triples."""
+    import math
+    def perp(t):
+        ca1, o, ca2 = t
+        u = [ca2[i] - ca1[i] for i in range(3)]
+        lu = math.sqrt(sum(x * x for x in u)) or 1.0
+        u = [x / lu for x in u]
+        v = [o[i] - ca1[i] for i in range(3)]
+        d = sum(v[i] * u[i] for i in range(3))
+        return [v[i] - d * u[i] for i in range(3)]
+    p, q = perp(before), perp(after)
+    lp, lq = math.sqrt(sum(x * x for x in p)), math.sqrt(sum(x * x for x in q))
+    if lp == 0 or lq == 0:
+        return 0.0
+    c = max(-1.0, min(1.0, sum(p[i] * q[i] for i in range(3)) / (lp * lq)))
+    return math.degrees(math.acos(c))
+
+def peptides_turned(imol, start):
+    """[(chain, res_no, alt conf, angle)] of the peptides whose carbonyl O turned more than rama_flip_turn_angle since `start`."""
+    now = peptide_orientations(imol)
+    out = []
+    for key in sorted(start, key=lambda k: (k[0], k[1], k[2])):
+        if key in now:
+            ang = peptide_turn_angle(start[key], now[key])
+            if ang > rama_flip_turn_angle:
+                out.append(key + (ang,))
+    return out
+
+def rama_run_begin(imol):
+    """Remember the peptide orientations at the start of a Refine/Improve Ramachandran Plot run (for the list of turned peptides)."""
+    rama_flip_run["imol"] = imol
+    rama_flip_run["start"] = peptide_orientations(imol)
+
+def _peptide_label(chain_id, res_no, alt):
+    return "%s %d-%d%s" % (chain_id, res_no, res_no + 1, (" alt conf " + alt) if alt else "")
+
+def rama_turned_by_refinement():
+    """Peptides turned by more than rama_flip_turn_angle since rama_run_begin, other than those flipped by a flip try."""
+    start = rama_flip_run.get("start") or {}
+    imol = rama_flip_run.get("imol", -1)
+    flipped = set((c, r) for c, r, a, t in rama_flip_run["flipped"])
+    return [t for t in peptides_turned(imol, start) if (t[0], t[1]) not in flipped]
+
+def rama_plain_report(stopped=False):
+    """(build 24) The end of a plain Refine/Improve Ramachandran Plot run: the peptides that the refinement turned (terminal, status bar)."""
