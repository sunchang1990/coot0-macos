+    lines = [head] + ["  %s (carbonyl O turned %d degrees)" % (_peptide_label(c, r, a), round(ang)) for c, r, a, ang in turned]
+    text = "\n".join(lines)
+    print("INFO:: " + text.replace("\n", "\nINFO:: "))
+    add_status_bar_text(head)
+    return text
+
