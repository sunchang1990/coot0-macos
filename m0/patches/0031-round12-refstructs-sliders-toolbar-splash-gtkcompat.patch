diff --git a/compat/splash/coot-splash.m b/compat/splash/coot-splash.m
new file mode 100644
index 0000000..fa4969e
--- /dev/null
+++ b/compat/splash/coot-splash.m
@@ -0,0 +1,119 @@
+// coot-splash: start-up picture for the macOS build of Coot 0.9.8.96.
+//
+// GTK 2 on macOS draws at 1 pixel = 1 point, so the picture that Coot's own start-up window shows is enlarged 2x on a Retina screen
+// and looks soft.  This helper (started by run-coot.sh before Coot) shows a 2x picture through AppKit instead, at the same size in points,
+// so every pixel of the picture is a pixel of the screen.  It closes itself when Coot has opened its main window (or Coot has
+// ended, or after --timeout seconds), but not before --min seconds have passed.
+//
+//   coot-splash IMAGE.png [--scale 2] [--pid PID] [--min 2.5] [--timeout 40]
+//   coot-splash --selftest IMAGE.png OUT.png [--scale 2]     (no window: loads the picture, draws it at 2x into a bitmap, writes OUT.png)
+//
+// Build:  clang -O2 -fobjc-arc -arch arm64 -mmacosx-version-min=11.0 -framework Cocoa -o coot-splash coot-splash.m
+#import <Cocoa/Cocoa.h>
+#import <CoreGraphics/CoreGraphics.h>
+#include <signal.h>
+#include <unistd.h>
+
+static NSImage *load_image(NSString *path, double scale, NSSize *points, NSSize *pixels) {
+  NSImage *img = [[NSImage alloc] initWithContentsOfFile:path];
+  if (!img) return nil;
+  NSBitmapImageRep *rep = nil;
+  for (NSImageRep *r in img.representations)
+    if ([r isKindOfClass:[NSBitmapImageRep class]]) { rep = (NSBitmapImageRep *)r; break; }
+  if (!rep) return nil;
+  *pixels = NSMakeSize(rep.pixelsWide, rep.pixelsHigh);
+  *points = NSMakeSize(rep.pixelsWide / scale, rep.pixelsHigh / scale);
+  [img setSize:*points];             // size in points; the bitmap keeps all its pixels
+  rep.size = *points;
+  return img;
+}
+
+// does the process have an ordinary window of some size on screen?
+static BOOL process_has_main_window(pid_t pid) {
+  CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements, kCGNullWindowID);
+  if (!list) return NO;
+  BOOL found = NO;
+  for (NSDictionary *w in (__bridge NSArray *)list) {
+    if ([w[(id)kCGWindowOwnerPID] intValue] != pid) continue;
+    if ([w[(id)kCGWindowLayer] intValue] != 0) continue;
+    CGRect b; if (!CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)w[(id)kCGWindowBounds], &b)) continue;
+    if (b.size.width >= 400 && b.size.height >= 300) { found = YES; break; }
+  }
+  CFRelease(list);
+  return found;
+}
+
+@interface Splash : NSObject
+@property NSWindow *win; @property pid_t pid; @property NSTimeInterval started, minShow, timeout; @property BOOL closing;
+- (void)tick:(NSTimer *)t;
+@end
+@implementation Splash
+- (void)tick:(NSTimer *)t {
+  if (self.closing) return;
+  NSTimeInterval age = [NSDate timeIntervalSinceReferenceDate] - self.started;
+  BOOL gone = (self.pid > 0 && kill(self.pid, 0) != 0 && errno == ESRCH);
+  BOOL ready = (self.pid > 0 && age >= self.minShow && process_has_main_window(self.pid));
+  if (gone || ready || age >= self.timeout) {
+    self.closing = YES;
+    if (gone) { [NSApp terminate:nil]; return; }
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext *ctx) { ctx.duration = 0.35; [[self.win animator] setAlphaValue:0.0]; }
+                        completionHandler:^{ [NSApp terminate:nil]; }];
+  }
+}
+@end
+
+int main(int argc, char **argv) {
+  @autoreleasepool {
+    NSString *path = nil, *out = nil; double scale = 2.0, minShow = 2.5, timeout = 40.0; pid_t pid = 0; BOOL selftest = NO;
+    for (int i = 1; i < argc; i++) {
+      NSString *a = [NSString stringWithUTF8String:argv[i]];
+      if ([a isEqualToString:@"--scale"] && i + 1 < argc) scale = atof(argv[++i]);
+      else if ([a isEqualToString:@"--pid"] && i + 1 < argc) pid = (pid_t)atoi(argv[++i]);
+      else if ([a isEqualToString:@"--min"] && i + 1 < argc) minShow = atof(argv[++i]);
+      else if ([a isEqualToString:@"--timeout"] && i + 1 < argc) timeout = atof(argv[++i]);
+      else if ([a isEqualToString:@"--selftest"]) selftest = YES;
+      else if (!path) path = a;
+      else if (selftest && !out) out = a;
+    }
+    if (!path || scale <= 0) { fprintf(stderr, "usage: coot-splash IMAGE.png [--scale 2] [--pid PID] [--min S] [--timeout S]\n"); return 2; }
+    NSSize pts, px; NSImage *img = load_image(path, scale, &pts, &px);
+    if (!img) { fprintf(stderr, "coot-splash: cannot read %s\n", argv[1]); return 1; }
+
+    if (selftest) {
+      // draw into a bitmap of 2 x the size in points (what a Retina window is): one picture pixel per bitmap pixel when scale == 2
+      NSInteger W = (NSInteger)(pts.width * 2), H = (NSInteger)(pts.height * 2);
+      NSBitmapImageRep *dst = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:W pixelsHigh:H bitsPerSample:8 samplesPerPixel:4
+                               hasAlpha:YES isPlanar:NO colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:0 bitsPerPixel:0];
+      [NSGraphicsContext saveGraphicsState];
+      NSGraphicsContext *gc = [NSGraphicsContext graphicsContextWithBitmapImageRep:dst];
+      [NSGraphicsContext setCurrentContext:gc];
+      [img drawInRect:NSMakeRect(0, 0, W, H) fromRect:NSZeroRect operation:NSCompositingOperationSourceOver fraction:1.0];
+      [NSGraphicsContext restoreGraphicsState];
+      printf("image %.0fx%.0f pixels -> %.0fx%.0f points (scale %.1f); bitmap %ldx%ld\n", px.width, px.height, pts.width, pts.height, scale, (long)W, (long)H);
+      if (out) {
+        NSData *png = dst ? [dst representationUsingType:NSBitmapImageFileTypePNG properties:@{}] : nil;
+        NSError *err = nil;
+        if (!png) { fprintf(stderr, "coot-splash: could not encode the bitmap\n"); return 1; }
+        if (![png writeToFile:out options:0 error:&err]) { fprintf(stderr, "coot-splash: cannot write %s: %s\n", [out UTF8String], [[err localizedDescription] UTF8String]); return 1; }
+      }
+      return 0;
+    }
+
+    NSApplication *app = [NSApplication sharedApplication];
+    [app setActivationPolicy:NSApplicationActivationPolicyAccessory];     // no Dock icon, no menu bar
+    NSRect vf = [[NSScreen mainScreen] visibleFrame];
+    NSRect r = NSMakeRect(floor(NSMidX(vf) - pts.width / 2), floor(NSMidY(vf) - pts.height / 2), pts.width, pts.height);
+    NSWindow *win = [[NSWindow alloc] initWithContentRect:r styleMask:NSWindowStyleMaskBorderless backing:NSBackingStoreBuffered defer:NO];
+    win.releasedWhenClosed = NO; win.opaque = YES; win.hasShadow = YES; win.ignoresMouseEvents = YES; win.level = NSFloatingWindowLevel;
+    NSImageView *iv = [[NSImageView alloc] initWithFrame:NSMakeRect(0, 0, pts.width, pts.height)];
+    iv.image = img; iv.imageScaling = NSImageScaleAxesIndependently; iv.imageFrameStyle = NSImageFrameNone;
+    win.contentView = iv;
+    [win orderFrontRegardless];
+
+    Splash *s = [Splash new]; s.win = win; s.pid = pid; s.started = [NSDate timeIntervalSinceReferenceDate]; s.minShow = minShow; s.timeout = timeout;
+    [NSTimer scheduledTimerWithTimeInterval:0.15 target:s selector:@selector(tick:) userInfo:nil repeats:YES];
+    signal(SIGTERM, SIG_DFL);
+    [app run];
+  }
+  return 0;
+}
