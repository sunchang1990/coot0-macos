@@ -675,3 +686,56 @@ def list_of_toolbar_functions():
 # to make combobox
 #coot_toolbar_combobox("MC restraints", ["no","aH","bS"], [set_secondary_structure_restraints_type], tooltip="Change refinement restraints for secondary structure")
   
+
+
+# ---- macOS port: toolbar buttons that are present from the first start ----------------------------------------------------
+# Sphere Refine, Sphere Refine +, Sphere Regularization and Sphere Regularization + are optional buttons (right-click the toolbar,
+# "Manage Buttons").  Used all the time, so the first start in a new (private) home folder writes them into
+# ~/.coot-preferences/coot_toolbuttons.py, which Coot reads right after the modules are loaded.  A marker file records that this has
+# been done: "Remove a Button" is then permanent, and Manage Buttons can bring a button back.  (run-coot.sh sets COOT_DEFAULT_TOOLBAR=1
+# when it uses its private home; COOT_NO_DEFAULT_TOOLBAR=1 switches this off.)
+default_toolbar_button_labels = ["Sphere Refine", "Sphere Refine +", "Sphere Regularization", "Sphere Regularization +"]
+
+def install_default_toolbar_buttons(home=None):
+  if os.getenv("COOT_NO_DEFAULT_TOOLBAR") or not os.getenv("COOT_DEFAULT_TOOLBAR"):
+    return False
+  home = home or os.getenv("HOME")
+  if not home:
+    return False
+  pref_dir = os.path.join(home, ".coot-preferences")
+  marker = os.path.join(pref_dir, ".default-toolbar-buttons-v1")
+  if os.path.exists(marker):
+    return False
+  filename = os.path.join(pref_dir, "coot_toolbuttons.py")
+  try:
+    if not os.path.isdir(pref_dir):
+      os.makedirs(pref_dir)
+    existing = open(filename).read() if os.path.isfile(filename) else ""
+    new_lines = []
+    for group in list_of_toolbar_functions():
+      for entry in group[1:]:
+        if not entry:
+          continue                      # (the empty groups, e.g. ["NMR", []])
+        label = entry[0]
+        if label in default_toolbar_button_labels and ("coot_toolbar_button(\"" + label + "\",") not in existing:
+          l = "coot_toolbar_button(\"" + label + "\", \"" + entry[1] + "\""
+          if len(entry) > 3 and entry[3]:
+            l += ", icon_name=\"" + entry[3] + "\""
+          if len(entry) > 2 and entry[2]:
+            l += ", tooltip=\"" + entry[2] + "\""
+          new_lines.append(l + ")\n")
+    if new_lines:
+      with open(filename, "a") as f:
+        if existing and not existing.endswith("\n"):
+          f.write("\n")
+        f.writelines(new_lines)
+    open(marker, "w").write("The default toolbar buttons (Sphere Refine, Sphere Regularization ...) were added to coot_toolbuttons.py once.\n")
+    print("INFO:: added the default toolbar buttons to", filename)
+    return True
+  except Exception as e:
+    print("WARNING:: could not add the default toolbar buttons:", e)
+    return False
+
+if (have_coot_python):
+  if coot_python.main_toolbar():
+    install_default_toolbar_buttons()
