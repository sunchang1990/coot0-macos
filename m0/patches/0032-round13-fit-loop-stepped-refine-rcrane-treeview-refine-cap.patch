+# macOS port: Stepped Refine used to refine each residue with "immediate replacement" (AutoAccept).  In Coot 0.9.8.96 that mode does not
+# start the redraw of the refining atoms and the main thread just waits for the refinement to finish, so nothing of the refinement was
+# visible: the atoms jumped.  Now the refinement runs as it does for Refine Zone: the atoms that are being refined are drawn in Coot's
+# refinement style (the "intermediate atoms": thicker grey-yellow bonds and balls, Ramachandran dodecs if switched on) while the minimizer
+# works, they stay on the screen for stepped_refine_show_seconds, then the result is accepted and the next residue is done.
+# COOT_STEPPED_REFINE_SHOW=<seconds> sets the time (default 0.6; 0 = accept at once, the old way).
+global stepped_refine_show_seconds
+try:
+    import os as _os
+    stepped_refine_show_seconds = float(_os.environ.get("COOT_STEPPED_REFINE_SHOW", "0.6"))
+except ValueError:
+    stepped_refine_show_seconds = 0.6
+
+def refine_auto_range_and_show(imol, chain_id, res_no, alt_conf, seconds=None, force=False):
+    """Refine the residues around res_no (refine_auto_range), keep the refining atoms on the screen for `seconds`, then accept."""
+    import time
+    if seconds is None:
+        seconds = stepped_refine_show_seconds
+    if seconds <= 0 or (not force and use_graphics_interface_state() == 0):
+        with NoBackups(imol):
+            with AutoAccept():
+                refine_auto_range(imol, chain_id, res_no, alt_conf)
+        return
+    if refinement_already_ongoing_p():
+        accept_regularizement()          # (a refinement left over from the user's own work)
+    import gtk
+    with NoBackups(imol):
+        refine_auto_range(imol, chain_id, res_no, alt_conf)
+        t0 = time.time()
+        while time.time() - t0 < seconds:
