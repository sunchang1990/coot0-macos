+# (macOS port, build 38) The whole-molecule runs (Stepped Refine, Fit Protein, the Ramachandran entries) work on the polymer
+# only: amino acids and nucleotides that are joined to a neighbour in their chain (peptide bond C(i-1)-N(i), phosphodiester
+# O3'(i-1)-P(i)).  Ions, waters and ligands are left as they are: a lone ion has no restraints to hold it, and refining it
+# with its sequence neighbours moved Mg2+ of 1EHZ away from its site (user, 24 Nov).  Modified residues (2MG, PSU, MSE, ...)
+# are polymer residues and stay in.
+def coot0_is_polymer_residue(imol, chain_id, res_no, ins_code=""):
+    import math
+    def atoms(r):
+        d = {}
+        try:
+            for a in residue_info(imol, chain_id, r, ins_code if r == res_no else "") or []:
+                d.setdefault(a[0][0].strip().replace("*", "'"), a[2][:3])
+        except Exception:
+            pass
+        return d
+    me = atoms(res_no)
+    if not me:
+        return False
+    def bonded(a, b):
+        return a is not None and b is not None and math.dist(a, b) < 2.0
+    if "CA" in me and ("N" in me or "C" in me):                       # amino acid (also one missing N or C, e.g. a partly built one)
+        prev, nxt = atoms(res_no - 1), atoms(res_no + 1)
+        return bonded(prev.get("C"), me.get("N")) or bonded(me.get("C"), nxt.get("N"))
+    if "C1'" in me and ("P" in me or "O3'" in me):                    # nucleotide
+        prev, nxt = atoms(res_no - 1), atoms(res_no + 1)
+        return bonded(prev.get("O3'"), me.get("P")) or bonded(me.get("O3'"), nxt.get("P"))
+    return False
+
+def coot0_polymer_specs(imol, specs):
+    """the specs [imol, chain, res_no, ins] of polymer residues; prints what was left out (ions, waters, ligands)"""
+    keep, skipped = [], {}
+    for sp in specs:
+        if coot0_is_polymer_residue(sp[0], sp[1], sp[2], sp[3]):
+            keep.append(sp)
+        else:
+            name = residue_name(sp[0], sp[1], sp[2], sp[3]) or "?"
+            skipped.setdefault(name, []).append("%s%s%s" % (sp[1], sp[2], sp[3]))
+    if skipped:
+        print("INFO:: refining protein and nucleic-acid residues only; left as they are: " +
+              "; ".join("%d %s (%s)" % (len(v), k, " ".join(v[:6]) + (" ..." if len(v) > 6 else "")) for k, v in sorted(skipped.items())))
+    return keep
+
