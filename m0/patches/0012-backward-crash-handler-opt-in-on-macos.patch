 namespace backward {
 
+#ifdef __APPLE__
+// macOS: the system crash reporter (~/Library/Logs/DiagnosticReports) gives better reports, and this handler was observed
+// to fault inside itself and hang the process after a fatal signal.  Opt in with COOT_BACKWARD=1.
+namespace {
+struct opt_in_signal_handling {
+   backward::SignalHandling *handler;
+   opt_in_signal_handling() : handler(0) {
+      const char *e = getenv("COOT_BACKWARD");
+      if (e && *e && *e != '0') handler = new backward::SignalHandling();
+   }
+};
+opt_in_signal_handling maybe_sh;
+}
+#else
 backward::SignalHandling sh;
+#endif
 
 } // namespace backward
