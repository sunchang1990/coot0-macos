diff --git a/scheme/guile-compat.scm b/scheme/guile-compat.scm
new file mode 100644
index 0000000..aae65e2
--- /dev/null
+++ b/scheme/guile-compat.scm
@@ -0,0 +1,71 @@
+;;;; guile-compat.scm -- Guile 1.8 -> Guile 2.x/3.x compatibility for the Coot scheme layer.
+;;;;
+;;;; Loaded by coot.scm on Guile 2+ only (see the cond-expand there).  It provides the parts of the
+;;;; Guile 1.x top-level environment that the rest of the scheme layer expects and that no longer exist:
+;;;;   - regex, threads, sxml: part of the Guile 1.x core, separate modules from Guile 2 on
+;;;;   - (os process) run / run-with-pipe / run-concurrently  (Guile 1.x)
+;;;;   - inet-aton (removed in Guile 3; inet-pton is the replacement)
+;;;; The scheme files are all load()ed into the same module, so these bindings are visible to all of them.
+
+(use-modules (ice-9 regex)      ; string-match, regexp-quote, match:substring ...
+             (ice-9 threads)    ; call-with-new-thread
+             (ice-9 popen)
+             (ice-9 rdelim)
+             (srfi srfi-1)
+             (sxml simple))     ; xml->sxml
+
+;; stdio to hand to a child: the *current* ports when they are file-descriptor ports (so that
+;; with-output-to-file / with-input-from-file redirect the child as they did with (os process)),
+;; else the process's fds 0/1/2.
+(define (%child-stdio)
+  (list (if (and (file-port? (current-input-port)))  (current-input-port)  0)
+        (if (and (file-port? (current-output-port))) (current-output-port) 1)
+        (if (and (file-port? (current-error-port)))  (current-error-port)  2)))
+
+;; (run prog arg ...) : run PROG (searched for in $PATH) and wait for it.
+;; Returns #t if the exit status was 0, else #f   (the (os process) semantics the scheme layer relies on).
+(define (run prog . args)
+  (force-output (current-output-port))
+  (let* ((stdio (%child-stdio))
+         (pid (catch 'system-error
+                (lambda () (spawn prog (cons prog args)
+                                  #:input (car stdio) #:output (cadr stdio) #:error (caddr stdio)))
+                (lambda args #f))))
+    (and pid
+         (let ((st (cdr (waitpid pid))))
+           (eqv? 0 (status:exit-val st))))))
+
+;; (run-concurrently prog arg ...) : start PROG and do not wait.  Returns the pid (or #f).
+(define (run-concurrently prog . args)
+  (force-output (current-output-port))
+  (let ((stdio (%child-stdio)))
+    (catch 'system-error
+      (lambda () (spawn prog (cons prog args)
+                        #:input (car stdio) #:output (cadr stdio) #:error (caddr stdio)))
+      (lambda args #f))))
+
+;; (run-with-pipe mode prog arg ...) :
+;;   "r+" -> (pid output-port . input-port)   output-port reads the child's stdout, input-port writes the child's stdin
+;;   "r"  -> (pid . output-port)
+;;   "w"  -> (pid . input-port)
+;; The caller is expected to close input-port to give the child EOF and to waitpid the pid.
+(define (run-with-pipe mode prog . args)
+  (let* ((rd? (or (string=? mode "r") (string=? mode "r+")))
+         (wr? (or (string=? mode "w") (string=? mode "r+")))
+         (to-child   (and wr? (pipe)))     ; (read-end . write-end)
+         (from-child (and rd? (pipe)))
+         (cloexec (lambda (p) (fcntl p F_SETFD FD_CLOEXEC))))
+    (if to-child   (cloexec (cdr to-child)))      ; parent's ends must not leak into the child
+    (if from-child (cloexec (car from-child)))
+    (let ((pid (spawn prog (cons prog args)
+                      #:input  (if to-child   (car to-child)   (current-input-port))
+                      #:output (if from-child (cdr from-child) (current-output-port))
+                      #:error  (current-error-port))))
+      (if to-child   (close-port (car to-child)))
+      (if from-child (close-port (cdr from-child)))
+      (cond ((string=? mode "r+") (cons pid (cons (car from-child) (cdr to-child))))
+            ((string=? mode "r")  (cons pid (car from-child)))
+            (else                 (cons pid (cdr to-child)))))))
+
+;; Guile 3 dropped inet-aton; inet-pton is its replacement (AF_INET only here).
+(define (inet-aton address) (inet-pton AF_INET address))
