+# Python port of (pepflips-by-difference-map-gui) from coot-gui.scm - the
+# 0.9.8 Python scripts referenced it from the Validate menu without
+# defining it.  Dialog: choose a difference map and a model and an N-sigma
+# cut-off, then show a box of buttons, one per potential pepflip.
+#
+def pepflips_by_difference_map_gui():
+
+    def delete_event(*args):
+        window.destroy()
+        return False
+
+    def on_ok_clicked(*args):
+        imol_coords = get_option_menu_active_molecule(option_menu_coords, model_mol_list)
+        imol_map    = get_option_menu_active_molecule(option_menu_map, map_mol_list)
+        try:
+            n_sigma = float(n_sigma_entry.get_text())
+        except ValueError:
+            info_dialog("Could not interpret the N-sigma cut-off as a number")
+            return
+        if imol_coords is False or imol_map is False:
+            info_dialog("Need a model molecule and a difference map")
+            return
+        specs = pepflip_using_difference_map(imol_coords, imol_map, n_sigma)
+        if not specs:
+            info_dialog("No pepflips found")
+        else:
+            dialog_box_of_buttons_from_specs("Potential Pepflip", [240, 170],
+                                             imol_coords, specs)
+        delete_event()
+
+    window = gtk.Window(gtk.WINDOW_TOPLEVEL)
+    window.set_title("Coot")
+    label = gtk.Label("Difference map")
+    vbox = gtk.VBox(False, 6)
+    hbox_buttons = gtk.HBox(False, 5)
+    hbox_sigma = gtk.HBox(False, 5)
+    option_menu_map = gtk.combo_box_new_text()
+    option_menu_coords = gtk.combo_box_new_text()
+    n_sigma_label = gtk.Label("N-sigma cut-off")
+    n_sigma_entry = gtk.Entry()
+    ok_button = gtk.Button("  OK  ")
+    cancel_button = gtk.Button(" Cancel ")
+    h_sep = gtk.HSeparator()
+    model_mol_list = fill_option_menu_with_coordinates_mol_options(option_menu_coords)
+    map_mol_list = fill_option_menu_with_difference_map_mol_options(option_menu_map)
+
+    window.set_default_size(370, 100)
+    window.add(vbox)
+    vbox.pack_start(label, False, False, 5)
+    vbox.pack_start(option_menu_map, True, True, 6)
+    vbox.pack_start(option_menu_coords, True, True, 6)
+    hbox_sigma.pack_start(n_sigma_label, False, False, 6)
+    hbox_sigma.pack_start(n_sigma_entry, False, False, 6)
+    vbox.pack_start(hbox_sigma, True, False, 6)
+    vbox.pack_start(h_sep, True, False, 2)
+    vbox.pack_start(hbox_buttons, False, False, 5)
+    hbox_buttons.pack_start(ok_button, True, False, 5)
+    hbox_buttons.pack_start(cancel_button, True, False, 5)
+    n_sigma_entry.set_text("4.0")
+
+    ok_button.connect("clicked", on_ok_clicked)
+    cancel_button.connect("clicked", delete_event)
+    window.show_all()
+
+
+# Python port of (molecule-atom-overlaps-gui imol) from find-baddies.scm:
+# a box of buttons, one for each atom overlap that is worse than 1.0 A^3.
+# Clicking a button centres on the first atom of the overlap.
+#
+def molecule_atom_overlaps_gui(imol):
+
+    baddie_limit = 1.0   # overlap volume (A^3) above which an overlap is listed
+
+    def make_buttons():
+        maob = molecule_atom_overlaps(imol)
+        if not isinstance(maob, list):
+            info_dialog(str(maob))
+            maob = []
+        buttons = []
+        for item in maob:
+            overlap = item['overlap-volume']
+            if overlap > baddie_limit:
+                atom_spec_1 = item['atom-1-spec']
+                atom_spec_2 = item['atom-2-spec']
+                res_name_1 = residue_spec_to_residue_name(imol, atom_spec_to_residue_spec(atom_spec_1))
+                res_name_2 = residue_spec_to_residue_name(imol, atom_spec_to_residue_spec(atom_spec_2))
+                label = ("Atom Overlap " + atom_spec_to_string(atom_spec_1) + " " + str(res_name_1) +
+                         " on " + atom_spec_to_string(atom_spec_2) + " " + str(res_name_2) +
+                         " OV: " + "%5.2f" % overlap)
+                def make_go_to(spec):
+                    # (GTK passes the button as the first argument)
+                    def go_to(*args):
+                        set_go_to_atom_molecule(imol)
+                        set_go_to_atom_from_atom_spec(spec)
+                    return go_to
+                buttons.append([label, make_go_to(atom_spec_1)])
+        return buttons
+
+    buttons = make_buttons()
+    title = "Atom Overlaps for Molecule " + str(imol) + " (" + str(len(buttons)) + ")"
+    return dialog_box_of_buttons(title, [350, 200], buttons, " Close ")
+
