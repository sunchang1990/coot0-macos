diff --git a/scheme/python-gui-bridge.scm b/scheme/python-gui-bridge.scm
new file mode 100644
index 0000000..0b7c804
--- /dev/null
+++ b/scheme/python-gui-bridge.scm
@@ -0,0 +1,46 @@
+;;;; python-gui-bridge.scm -- macOS port.  This Coot has no guile-gtk (no gtk-* procedures, no gtk-timeout-add), so the
+;;;; scripted GUI is Python.  A few places in the C++ code still ask the Scheme interpreter for a GUI function when Guile
+;;;; is compiled in; for those the Scheme function is handed to the Python version here.  Loaded last, so it overrides.
+
+;; a Scheme value as Python source text
+(define (coot-python-literal x)
+  (cond ((string? x) (call-with-output-string (lambda (port) (write x port))))
+        ((eq? x #t) "True")
+        ((eq? x #f) "False")
+        ((number? x) (number->string x))
+        ((null? x) "[]")
+        ((symbol? x) (coot-python-literal (symbol->string x)))
+        ((and (pair? x) (not (list? x)))
+         (string-append "[" (coot-python-literal (car x)) ", " (coot-python-literal (cdr x)) "]"))
+        ((list? x) (string-append "[" (string-join (map coot-python-literal x) ", ") "]"))
+        (else "None")))
+
+;; call a Python function (by name, in __main__) with Scheme values as arguments
+(define (coot-call-python function-name . args)
+  (run-python-command (string-append function-name "(" (string-join (map coot-python-literal args) ", ") ")")))
+
+;; Calculate > Run Refmac:  the Scheme version starts refmac and then polls with gtk-timeout-add to read the new
+;; model and maps; the Python version does the same with a GLib timeout.
+(if (not (defined? 'gtk-timeout-add))
+    (set! run-refmac-by-filename
+          (lambda args
+            (apply coot-call-python "run_refmac_by_filename" args))))
+
+;; Validate > GLN and ASN B-factor Outliers:  C++ calls (interesting-things-with-fix-maybe title baddies), baddies being
+;; (list (list "label" imol "chain" resno "ins" "atom" "alt" [fix]) ...) where a fix is the Scheme lambda that C++ makes
+;; for a 180 degree side-chain flip.  The Python list has [do_180_degree_side_chain_flip, imol, chain, resno, ins, alt]
+;; in its place.  (Without guile-gtk there is no Scheme version of this window.)
+(define (interesting-things-with-fix-maybe title baddies)
+  (let ((python-baddies
+         (map (lambda (b)
+                (let ((base (list-head b 7)))
+                  (if (> (length b) 7)
+                      (let ((imol (list-ref b 1)) (chain (list-ref b 2)) (resno (list-ref b 3))
+                            (ins (list-ref b 4)) (alt (list-ref b 6)))
+                        (string-append (substring (coot-python-literal base) 0 (- (string-length (coot-python-literal base)) 1))
+                                       ", [do_180_degree_side_chain_flip, "
+                                       (string-join (map coot-python-literal (list imol chain resno ins alt)) ", ") "]]"))
+                      (coot-python-literal base))))
+              baddies)))
+    (run-python-command (string-append "interesting_things_with_fix_maybe(" (coot-python-literal title)
+                                       ", [" (string-join python-baddies ", ") "])"))))
