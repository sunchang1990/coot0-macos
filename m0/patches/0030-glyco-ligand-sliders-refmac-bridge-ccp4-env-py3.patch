+# macOS port: environment for CCP4 programs that Coot starts (refmac5, ...).  Those programs need the variables that
+# CCP4's setup script exports (refmac5 stops with "Cannot open environ.def" without CINCL).  Coot's launcher cleans the
+# environment on purpose (CLIB would redirect Coot's own dictionary lookup), so the variables are added here, to the
+# environment of the child process only, and only where they are not set already.  The CCP4 installation is taken from
+# $CCP4, else $COOT_CCP4_HOME (set by run-coot.sh when it finds one), else /Applications/ccp4-*.
+def ccp4_child_env(base_env=None):
+    import os, glob, tempfile
+    env = dict(os.environ if base_env is None else base_env)
+    home = env.get("CCP4") or env.get("COOT_CCP4_HOME") or ""
+    if not home or not os.path.isdir(home):
+        home = ""
+        for d in sorted(glob.glob("/Applications/ccp4-*"), reverse=True):
+            if os.path.isdir(os.path.join(d, "bin")):
+                home = d
+                break
+    if not home:
+        return env
+    try:
+        import getpass
+        user = getpass.getuser()
+    except Exception:
+        user = "user"
+    scr = os.path.join(tempfile.gettempdir(), "ccp4-" + user)
+    wanted = [("CCP4",      home),
+              ("CBIN",      os.path.join(home, "bin")),
+              ("CLIB",      os.path.join(home, "lib")),
+              ("CLIBD",     os.path.join(home, "lib", "data")),
+              ("CETC",      os.path.join(home, "etc")),
+              ("CINCL",     os.path.join(home, "include")),
+              ("MMCIFDIC",  os.path.join(home, "lib", "ccp4", "cif_mmdic.lib")),
+              ("CCP4_SCR",  scr),
+              ("CCP4_OPEN", "UNKNOWN"),
+              ("GFORTRAN_UNBUFFERED_PRECONNECTED", "Y")]
+    for key, value in wanted:
+        if not env.get(key):
+            env[key] = value
+    try:
+        if not os.path.isdir(env["CCP4_SCR"]):
+            os.makedirs(env["CCP4_SCR"])
+    except Exception:
+        pass
+    return env
+
