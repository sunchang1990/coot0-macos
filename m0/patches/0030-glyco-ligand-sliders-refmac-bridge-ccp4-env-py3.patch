 (define (%sh-quote s)
   (string-append "'" (string-join (string-split s #\') "'\\''") "'"))
 
-;; "prog arg1 arg2 ..." with every word quoted
+;; CCP4 programs (refmac5, libcheck, mapman, ...) need CCP4's environment (CINCL for environ.def, CCP4_SCR, ...).
+;; Coot itself must not see it (CCP4 and CLIB change how Coot finds its dictionaries), so it is given to the
+;; programs Coot starts and to nothing else.  Variables that are already set are left alone.
+(use-modules (ice-9 ftw))
+(define %ccp4-env-words
+  (let ((cache 'unset))
+    (lambda ()
+      (if (eq? cache 'unset)
+          (set! cache
+                (catch #t
+                  (lambda ()
+                    (let* ((dir? (lambda (d) (and d (file-exists? d) (file-is-directory? d))))
+                           (home (let ((h (or (getenv "CCP4") (getenv "COOT_CCP4_HOME"))))
+                                   (if (dir? h)
+                                       h
+                                       (let ((found (filter (lambda (d) (dir? (string-append d "/bin")))
+                                                            (map (lambda (n) (string-append "/Applications/" n))
+                                                                 (or (scandir "/Applications" (lambda (n) (string-prefix? "ccp4-" n))) '())))))
+                                         (if (null? found) #f (car (reverse found))))))))
+                      (if (not home)
+                          '()
+                          (let* ((scr (string-append (or (getenv "TMPDIR") "/tmp") "/ccp4-" (or (getenv "USER") "user")))
+                                 (wanted (list (cons "CCP4" home)
+                                               (cons "CBIN" (string-append home "/bin"))
+                                               (cons "CLIB" (string-append home "/lib"))
+                                               (cons "CLIBD" (string-append home "/lib/data"))
+                                               (cons "CETC" (string-append home "/etc"))
+                                               (cons "CINCL" (string-append home "/include"))
+                                               (cons "MMCIFDIC" (string-append home "/lib/ccp4/cif_mmdic.lib"))
+                                               (cons "CCP4_SCR" scr)
+                                               (cons "CCP4_OPEN" "UNKNOWN")
+                                               (cons "GFORTRAN_UNBUFFERED_PRECONNECTED" "Y"))))
+                            (catch #t (lambda () (if (not (file-exists? scr)) (mkdir scr))) (lambda args #f))
+                            (filter-map (lambda (kv)
+                                          (let ((v (getenv (car kv))))
+                                            (if (and v (not (string-null? v)))
+                                                #f
+                                                (string-append (car kv) "=" (cdr kv)))))
+                                        wanted)))))
+                  (lambda args '()))))
+      cache)))
+
+;; "prog arg1 arg2 ..." with every word quoted (started through env(1) so that CCP4 programs get CCP4's environment)
 (define (%command-line prog args)
-  (string-join (map %sh-quote (cons prog args)) " "))
+  (let ((env-words (%ccp4-env-words)))
+    (string-join (map %sh-quote (if (null? env-words)
+                                    (cons prog args)
+                                    (append (cons "/usr/bin/env" env-words) (cons prog args))))
+                 " ")))
 
