+# add_linked_residue() (C++, Python flavour) returns the spec of the new residue ([True, chain, resno, ins]) only when
+# "fit and refine for link addition" is on (set_add_linked_residue_do_fit_and_refine, on by default); otherwise it adds
+# the residue but returns False. The N-linked glycan dialog switches that off, so the callers below never got the new
+# residue back (no extra restraints, no refinement, no further residues for a tree). This wrapper always gives the
+# spec: if the C++ call returned False it finds the residue that appeared next to the parent.
+def add_linked_residue_and_get_spec(imol, chain_id, res_no, ins_code, new_res_type, link_type, mode=2):
+    parent = [chain_id, res_no, ins_code]
+    def neighbours():
+        ns = residues_near_residue(imol, parent, 2.2)
+        return [list(n)[-3:] for n in ns] if isinstance(ns, list) else []
+    before = neighbours()
+    r = add_linked_residue(imol, chain_id, res_no, ins_code, new_res_type, link_type, mode)
+    if isinstance(r, list):
+        return r
+    new_ones = [n for n in neighbours() if n not in before]
+    if len(new_ones) == 1:
+        return [True] + new_ones[0]
+    return r
+
