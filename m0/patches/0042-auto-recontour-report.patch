+# coot0 (build 26): the two Auto-Recontour entries (Cryo-EM menu) said nothing; now they
+# report the new mode in the terminal and in the status bar.
+def set_auto_recontour_map_and_report(state):
+   set_auto_recontour_map(state)
+   if get_auto_recontour_map():
+      msg = ("Auto-recontour map mode: ON. Maps are contoured again around the new centre "
+             "whenever the view centre moves.")
+   else:
+      msg = ("Auto-recontour map mode: OFF. Maps keep their current contours when the view "
+             "centre moves (turn on again: Cryo-EM > Enable Auto-Recontour Map Mode).")
+   print("INFO:: " + msg + "  [script: set_auto_recontour_map(%d)]" % state)
+   try:
+      add_status_bar_text(msg)
+   except Exception:
+      pass
+   return msg
+
