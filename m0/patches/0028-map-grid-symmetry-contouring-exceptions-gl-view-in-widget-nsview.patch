+bool
+coot::util::grid_is_compatible_with_spacegroup(const clipper::Spacegroup &spgr,
+                                               const clipper::Grid_sampling &gs) {
+
+   if (gs.nu() <= 0 || gs.nv() <= 0 || gs.nw() <= 0) return false;
+   const double n[3] = { double(gs.nu()), double(gs.nv()), double(gs.nw()) };
+   const double tol = 1.0e-4;
+   for (int isym=0; isym<spgr.num_symops(); isym++) {
+      const clipper::Symop &op = spgr.symop(isym);
+      for (int i=0; i<3; i++) {
+         // translation part must be a whole number of grid steps
+         double t = op.trn()[i] * n[i];
+         if (std::fabs(t - std::floor(t + 0.5)) > tol) return false;
+         // the rotation part must map grid points onto grid points
+         for (int j=0; j<3; j++) {
+            double r = op.rot()(i,j) * n[i] / n[j];
+            if (std::fabs(r - std::floor(r + 0.5)) > tol) return false;
+         }
+      }
+   }
+   return true;
+}
+
+clipper::Grid_sampling
+coot::util::compatible_grid_sampling(const clipper::Spacegroup &spgr,
+                                     const clipper::Cell &cell,
+                                     int nu, int nv, int nw) {
+
+   clipper::Grid_sampling gs_wanted(nu, nv, nw);
+   if (grid_is_compatible_with_spacegroup(spgr, gs_wanted))
+      return gs_wanted;
+
+   // let clipper choose a grid that is OK for this space group, with a spacing no
+   // coarser than the one that was asked for. Shrink the spacing a little at a time in
+   // the (unexpected) case that the first answer still fails the test.
+   double spacing = std::min(std::min(cell.a()/double(nu), cell.b()/double(nv)),
+                             cell.c()/double(nw));
+   for (int itry=0; itry<100; itry++) {
+      clipper::Grid_sampling gs(spgr, cell, clipper::Resolution(2.0 * spacing), 1.0);
+      if (grid_is_compatible_with_spacegroup(spgr, gs))
+         return gs;
+      spacing *= 0.98;
+   }
+   return gs_wanted; // not reached in practice
+}
+
 clipper::Xmap<float>
    coot::util::reinterp_map(const clipper::Xmap<float> &xmap_in, float sampling_multiplier) {
 
    clipper::Grid_sampling gs_old = xmap_in.grid_sampling();
-   clipper::Grid_sampling gs(xmap_in.grid_sampling().nu()*sampling_multiplier,
-                             xmap_in.grid_sampling().nv()*sampling_multiplier,
-                             xmap_in.grid_sampling().nw()*sampling_multiplier);
+   // macOS port: a non-integer multiplier (e.g. the 1.25 of "Make a Smoother Copy") can give
+   // a grid that is not allowed by the space group (e.g. 225 for P 43 21 2), which crashed
+   // Coot on first use of the new map. Choose a grid that is valid for the space group.
+   clipper::Grid_sampling gs =
+      compatible_grid_sampling(xmap_in.spacegroup(), xmap_in.cell(),
+                               int(xmap_in.grid_sampling().nu()*sampling_multiplier),
+                               int(xmap_in.grid_sampling().nv()*sampling_multiplier),
+                               int(xmap_in.grid_sampling().nw()*sampling_multiplier));
 
    clipper::Xmap<float> xmap_new(xmap_in.spacegroup(), xmap_in.cell(), gs);
 
