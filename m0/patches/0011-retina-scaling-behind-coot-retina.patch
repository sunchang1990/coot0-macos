diff --git a/compat/coot-gl-scale.h b/compat/coot-gl-scale.h
new file mode 100644
index 0000000..1d6b84f
--- /dev/null
+++ b/compat/coot-gl-scale.h
@@ -0,0 +1,20 @@
+/* coot-gl-scale.h -- GL units: GTK widget sizes and mouse positions are in points; the GL framebuffer is in pixels.
+ * With COOT_RETINA=1 the GL surface is 2x the point size on a Retina display, so widths given "in pixels" by Coot must scale.
+ * Include AFTER the OpenGL headers.  coot_gl_pixel_scale is maintained by compat/gl-seam/coot-gl-seam.mm (1.0 unless COOT_RETINA=1). */
+#ifndef COOT_GL_SCALE_H
+#define COOT_GL_SCALE_H
+#ifdef __APPLE__
+#include <OpenGL/gl.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern double coot_gl_pixel_scale;
+#ifdef __cplusplus
+}
+#endif
+static inline void coot_glLineWidth(GLfloat w) { glLineWidth(w * (GLfloat)coot_gl_pixel_scale); }
+static inline void coot_glPointSize(GLfloat s) { glPointSize(s * (GLfloat)coot_gl_pixel_scale); }
+#define glLineWidth(w) coot_glLineWidth(w)
+#define glPointSize(s) coot_glPointSize(s)
+#endif /* __APPLE__ */
+#endif /* COOT_GL_SCALE_H */
