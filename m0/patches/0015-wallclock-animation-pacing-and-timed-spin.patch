diff --git a/src/coot-animation.hh b/src/coot-animation.hh
new file mode 100644
index 0000000..c4ae039
--- /dev/null
+++ b/src/coot-animation.hh
@@ -0,0 +1,62 @@
+// coot-animation.hh -- wall-clock pacing for Coot's synchronous view animations (macOS port)
+//
+// Coot animates view changes (smooth centring, view interpolation, "go to ligand", scripted
+// rotations) with loops of the form
+//
+//     for (istep=0; istep<nsteps; istep++) { change_the_view(istep); graphics_draw(); }
+//
+// On the original platform graphics_draw() == gtk_widget_draw() paints synchronously and the
+// X server/GLX takes real time per frame, so nsteps steps take about nsteps frame times.
+// With GTK2-Quartz + a Cocoa GL view the frames are issued back to back (and not necessarily
+// shown), so the whole animation collapses to a jump.
+//
+// animation_pacer_t restores the intended timing without restructuring the loops: call
+// end_of_step() after graphics_draw() in each iteration.  It lets pending GTK/Cocoa events run (so the
+// frame reaches the screen), then waits until the step's deadline.  One step takes
+// COOT_ANIM_MS_PER_STEP milliseconds (default 1000/60 = one frame at 60 Hz; 0 turns pacing off).
+// It does nothing when there is no GL widget (headless / --no-graphics) so scripts are not slowed.
+#ifndef COOT_ANIMATION_HH
+#define COOT_ANIMATION_HH
+
+#include <chrono>
+#include <cstdlib>
+#include <thread>
+#include <gtk/gtk.h>
+
+namespace coot {
+
+   class animation_pacer_t {
+      using clock_t_ = std::chrono::steady_clock;
+      clock_t_::time_point t_deadline;
+      std::chrono::microseconds step_us;
+      bool active;
+      static int &depth() { static int d = 0; return d; }
+   public:
+      // glarea: graphics_info_t::glarea (NULL when running without graphics)
+      explicit animation_pacer_t(GtkWidget *glarea, bool enabled = true) {
+         double ms = 1000.0/60.0;
+         const char *e = getenv("COOT_ANIM_MS_PER_STEP");
+         if (e) { double v = atof(e); if (v >= 0.0 && v < 1000.0) ms = v; }
+         step_us = std::chrono::microseconds(static_cast<long>(ms * 1000.0));
+         active = (glarea != NULL) && enabled && (step_us.count() > 0);
+         t_deadline = clock_t_::now();
+      }
+      void end_of_step() {
+         if (!active) return;
+         if (depth() == 0) {                  // do not recurse into event handling from a nested animation
+            depth()++;
+            for (int k = 0; k < 6 && gtk_events_pending(); k++)
+               gtk_main_iteration_do(FALSE);
+            depth()--;
+         }
+         t_deadline += step_us;
+         clock_t_::time_point now = clock_t_::now();
+         if (t_deadline > now)
+            std::this_thread::sleep_until(t_deadline);
+         else if (now - t_deadline > 4 * step_us)
+            t_deadline = now;                 // rendering is slower than the target rate: do not try to catch up
+      }
+   };
+
+}
+#endif // COOT_ANIMATION_HH
