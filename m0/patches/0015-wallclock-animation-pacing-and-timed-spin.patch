 coot::refinement_results_t graphics_info_t::saved_dragged_refinement_results(0, -2, "");
-float graphics_info_t::idle_function_rotate_angle = 1.0; // degrees
+// macOS port: degrees per nominal 1/60 s frame (animate_idle_spin() is time-based, so this is
+// really a speed: value*60 degrees per second).  The original default (1.0) assumed a slow
+// redraw rate; at 60 Hz it is a full turn in 6 s, which is too fast.  0.15 -> 9 degrees/s.
+float graphics_info_t::idle_function_rotate_angle = 0.15;
 bool  graphics_info_t::refinement_move_atoms_with_zero_occupancy_flag = 1; // yes
 
 bool graphics_info_t::post_intermediate_atoms_moved_ready;
@@ -3608,8 +3611,18 @@ animate_idle_spin(GtkWidget *widget) {
    float spin_quat[4];
    graphics_info_t g;
 
-   // spin it 1 degree * user angle setting
-   trackball(spin_quat, 0, 0, g.idle_function_rotate_angle*0.0174,
+   // macOS port: scale the step by the elapsed time, so that the spin speed
+   // (idle_function_rotate_angle degrees per 1/60 s) does not depend on how often we are called.
+   static long t_previous_ms = -1000000;
+   long t_now_ms = coot::gl_timer::elapsed_ms();
+   long dt_ms = t_now_ms - t_previous_ms;
+   t_previous_ms = t_now_ms;
+   if (dt_ms > 250 || dt_ms < 1) dt_ms = 17; // first call after (re)starting (or too quick to measure)
+   if (dt_ms > 50) dt_ms = 50;               // a stall must not become a jump
+   float time_scale = static_cast<float>(dt_ms) * 0.06f; // 1.0 for a 16.67 ms frame
+
+   // spin by (user angle setting) degrees per nominal frame
+   trackball(spin_quat, 0, 0, g.idle_function_rotate_angle*0.0174*time_scale,
 	     0.0, g.get_trackball_size());
    add_quats(spin_quat, g.quat, g.quat);
 
