     return target
 
+# (build 29) the pages are served from 127.0.0.1 by Coot itself: Safari (round 28, JJ3) would not follow the old
+# file-to-file forwarding page, and macOS "open" drops the #heading of a file:// URL.  An http:// URL keeps it.
+# The server runs in Coot's GTK main loop (polled every 50 ms): a Python thread would not run while Coot is idle.
+_coot0_docs_server = None
+def coot0_docs_server_poll():
+    import select
+    srv = _coot0_docs_server
+    if srv is None: return False
+    try:
+        while select.select([srv.socket], [], [], 0)[0]:
+            srv.handle_request()
+    except Exception as e:
+        print("WARNING:: documentation server:", e)
+    return True
+
+def coot0_docs_server_port():
+    """starts the documentation server once (127.0.0.1 only, the docs/html folder only); its port, or None"""
+    global _coot0_docs_server
+    if _coot0_docs_server is None:
+        try:
+            import http.server, functools, gobject
+            class Handler(http.server.SimpleHTTPRequestHandler):
+                timeout = 0.5                               # a browser that connects and sends nothing cannot hold Coot up
+                def log_message(self, *a): pass
+            srv = http.server.HTTPServer(("127.0.0.1", 0), functools.partial(Handler, directory=coot0_docs_html_dir()))
+            srv.timeout = 0
+            _coot0_docs_server = srv
+            gobject.timeout_add(50, coot0_docs_server_poll)
+        except Exception as e:
+            print("WARNING:: could not start the documentation server:", e)
+            return None
+    return _coot0_docs_server.server_address[1]
+
