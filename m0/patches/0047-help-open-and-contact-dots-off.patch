+# (coot0, build 29) user, 20 Nov: "is there a function that can turn off the dots (Ctrl-1)?"  Ctrl-1 and Ligand > Coot All-Atom
+# Contact Dots draw generic objects named "Molecule N: wide-contact" ... "Molecule N: clashes"; Coot 0.9.8.96 has nothing to remove them
+# but Draw > Generic Objects.  This empties and hides them (Ctrl-1 again draws them anew).
+coot0_contact_dot_types = ["wide-contact", "close-contact", "small-overlap", "big-overlap", "bad-overlap", "H-bond", "vdw-surface", "clashes"]
+def coot0_contact_dots_off(imol=-1):
+    """hides the all-atom contact dots of molecule imol (-1: of every molecule); returns how many dot objects were hidden"""
+    import re
+    n = 0
+    for i in range(number_of_generic_objects()):
+        if is_closed_generic_object_p(i): continue
+        m = re.match(r"Molecule (\d+): (.*)$", generic_object_name(i) or "")
+        if m and m.group(2) in coot0_contact_dot_types and (imol < 0 or int(m.group(1)) == imol):
+            generic_object_clear(i)
+            set_display_generic_object_simple(i, 0)
+            n += 1
+    graphics_draw()
+    return n
