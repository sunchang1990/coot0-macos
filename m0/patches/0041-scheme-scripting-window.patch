 ;; back to <id>_final.cif and shows the guided tour with the Python window.
 (define (get-pdb-redo text)
   (coot-call-python "get_pdb_redo" text))
+
+;; macOS port (build 25): the Scheme scripting window.  The C++ "simple" Scheme window of 0.9.8.96 showed a fixed
+;; placeholder text and threw the result of a command away; coot0 replaces it with a window written in Python
+;; (coot_gui.py: scheme_scripting_window) that sends what you type here and shows what comes back.
+;; (coot0-console-eval "text"): evaluate every expression in text in the user module; returns one string:
+;;   <printed output> US ok|error US <values, one per line, written as Scheme would read them | the error message>
+;; (US = the ASCII unit separator, character 31).
+(use-modules (ice-9 eval-string))
+(define (coot0-console-eval text)
+  (let* ((out (open-output-string))
+         (sep (string (integer->char 31)))
+         (res (catch #t
+                (lambda ()
+                  (with-output-to-port out
+                    (lambda ()
+                      (with-error-to-port out
+                        (lambda ()
+                          (call-with-values
+                              (lambda () (eval-string text #:module (resolve-module '(guile-user))))
+                            (lambda vals (cons 'ok vals))))))))
+                (lambda (key . args)
+                  (cons 'error (call-with-output-string
+                                 (lambda (p) (print-exception p #f key args))))))))
+    (string-append (get-output-string out) sep (symbol->string (car res)) sep
+                   (if (eq? (car res) 'ok)
+                       (string-join (map (lambda (v) (if (unspecified? v) "" (object->string v)))
+                                         (cdr res)) "\n")
+                       (cdr res)))))
+
+;; macOS port (build 25): coot0's launcher copies the terminal output into logs/ (through a pipe), and Guile then
+;; held back what Scheme printed (display, format #t) in a large buffer, often until Coot quit.  Line buffering
+;; makes each line appear at once, as Python's output does (PYTHONUNBUFFERED in run-coot.sh).
+(define coot0-stdout-line-buffered
+  (catch #t
+    (lambda () (setvbuf (current-output-port) 'line) (setvbuf (current-error-port) 'none) #t)
+    (lambda args #f)))
