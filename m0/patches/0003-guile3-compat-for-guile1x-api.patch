+#ifndef COOT_GUILE_1X_COMPAT
+#define COOT_GUILE_1X_COMPAT
+#define SCM_MAKINUM(n)          scm_from_long(static_cast<long>(n))
+#define scm_makfrom0str(s)      scm_from_locale_string(s)
+#define scm_double2num(d)       scm_from_double(d)
+#define scm_float2num(d)        scm_from_double(d)
+#define scm_int2num(i)          scm_from_int(i)
+#define scm_str2symbol(s)       scm_from_locale_symbol(s)
+#define SCM_LIST2(a,b)          scm_list_2((a),(b))
+#define SCM_LIST3(a,b,c)        scm_list_3((a),(b),(c))
+#define SCM_LIST4(a,b,c,d)      scm_list_4((a),(b),(c),(d))
+#define SCM_LIST6(a,b,c,d,e,f)  scm_list_n((a),(b),(c),(d),(e),(f),SCM_UNDEFINED)
+#endif // COOT_GUILE_1X_COMPAT
+#endif // SCM_MAJOR_VERSION >= 3
+#else
 #define scm_to_int gh_scm2int
 #define scm_to_locale_string SCM_STRING_CHARS
 #define scm_from_locale_string scm_makfrom0str
