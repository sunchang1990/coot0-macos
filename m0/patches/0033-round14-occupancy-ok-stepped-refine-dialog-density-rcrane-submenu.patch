+# macOS port (build 14): the entries are a sub-menu "RCrane" of the Calculate menu that exists from start-up (build 13 had a "RCrane launch" entry
+# that created a new top-level menu when used; on one machine that gave no menu and no message).  Every entry says in the terminal / log what
+# it does, the Coot / monomer-library check of RCrane runs the first time an entry is used, and an exception of a handler is printed with its
+# traceback and shown in a message window instead of being lost.
+
 import gtk, os.path, imp
 from .coot_gui_adapter import coot_menubar_menu, add_simple_coot_menu_menuitem
 import rcrane
 
+_submenu = None          # the gtk.Menu of "Calculate > RCrane" once it exists
+_check_passed = False    # the pre-launch check (Coot version, monomer library) passed
+
+
+def _error_window(title, text):
+    try:
+        d = gtk.MessageDialog(type = gtk.MESSAGE_ERROR, buttons = gtk.BUTTONS_OK)
+        d.set_title(title)
+        d.set_markup(text.replace("&", "&amp;").replace("<", "&lt;"))
+        d.run()
+        d.destroy()
+    except Exception:
+        pass
+
+
+def _guarded(label, action, check = True):
+    """The "activate" handler of the menu entry `label`: logs, runs the pre-launch check once, calls `action`, reports exceptions."""
+    def handler(*args):
+        global _check_passed
+        print("INFO:: RCrane: \"%s\" selected" % label)
+        try:
+            if check and not _check_passed:
+                _check_passed = bool(rcrane.checkCootAndReportErrors())
+                if not _check_passed:
+                    print("INFO:: RCrane: the pre-launch check failed (see the message above): \"%s\" was not started" % label)
+                    return
+            action()
+        except Exception:
+            import traceback
+            print("ERROR:: RCrane: \"%s\" failed:" % label)
+            traceback.print_exc()
+            _error_window("RCrane Error", "\"%s\" failed:\n\n%s\n\nThe full traceback is in the terminal / the log file." % (label, traceback.format_exc()[-700:]))
+    return handler
+
 
