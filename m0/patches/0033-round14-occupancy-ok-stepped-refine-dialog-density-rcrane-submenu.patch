+# macOS port (build 14): Coot opens its "Accept Refinement?" window for every ordinary refinement.  Stepped Refine accepts each residue itself, so that
+# window (a floating window titled "Accept Refinement?", or the docked panel) is useless there - its buttons act on a refinement that is already
+# finished - and it stayed on the screen.  It is hidden the moment it appears (hiding does not reject the refinement) and closed after the accept
+# (closing it after the accept is what its own Accept button does).
+def hide_accept_reject_dialog(destroy=False):
+    """Hide (destroy=False) or close (destroy=True) Coot's \"Accept Refinement?\" window; returns the number of windows found."""
+    n = 0
+    try:
+        import gtk
+        for w in gtk.window_list_toplevels():
+            try:
+                if w.get_title() == "Accept Refinement?":
+                    n += 1
+                    if destroy: w.destroy()
+                    else: w.hide()
+            except Exception:
+                pass
+    except Exception:
+        pass
+    try:
+        if accept_reject_dialog_docked_state():                   # the docked version: hides the panel without changing the preference
+            old = accept_reject_dialog_docked_show_state()
+            set_accept_reject_dialog_docked_show(0); set_accept_reject_dialog_docked_show(old)
+            n += 1
+    except Exception:
+        pass
+    return n
+
