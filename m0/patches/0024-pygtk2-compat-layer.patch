+"""_gtk2core.py -- ctypes foundation of the PyGTK 2 compatibility layer used by Coot 0.9.8.96's Python scripts on macOS.
+
+Coot's python/*.py scripts were written for PyGTK 2 (`import gtk, gobject, pango`).  PyGTK does not exist for Python 3, so this package provides the
+subset of its API that those scripts use (and, through generic dispatch, most of the rest) directly on the GTK 2.24 libraries that Coot itself is linked to.
+
+Design rules
+  * C prototypes come from _gtk2_protos.json (generated with clang from the GTK headers: tools/gen_gtk_protos.py), never typed by hand.
+  * Variadic C functions are never called with extra arguments: on Apple-silicon the variadic calling convention differs and ctypes gets it wrong
+    (a call such as snprintf(buf, n, "%d %s", ...) crashes the interpreter).  Variadic entry points are replaced by non-variadic equivalents.
+  * A Python wrapper owns one reference to its GObject; callbacks are kept alive by a table that does not depend on the wrapper's lifetime.
+  * No import of anything outside the standard library.
+"""
+import ctypes, json, os, sys, weakref, traceback, re
+from ctypes import (c_void_p, c_int, c_uint, c_ulong, c_double, c_float, c_char_p, c_bool, c_int64, c_uint64, c_short, c_ushort, c_byte, c_ubyte,
+                    byref, cast, CFUNCTYPE, Structure, POINTER, sizeof, addressof)
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+HEADLESS = bool(os.environ.get("COOT_GTK2COMPAT_HEADLESS"))     # tests only: windows are never shown (no window server in the build sandbox)
+
+# ------------------------------------------------------------------------------------------------ libraries
+_libs = []
+def _open_libs():
+    if _libs: return
+    g = ctypes.CDLL(None)                                     # inside coot-bin the GTK libraries are already loaded into the process
+    if hasattr(g, "gtk_button_new") and hasattr(g, "g_object_ref"):
+        _libs.append(g); return
+    libdir = os.environ.get("COOT_GTK2_LIBDIR") or os.path.join(os.environ.get("COOT_PREFIX", ""), "lib")
+    for stem in ("libglib-2.0.0", "libgobject-2.0.0", "libgdk_pixbuf-2.0.0", "libpango-1.0.0", "libgdk-quartz-2.0.0", "libgtk-quartz-2.0.0"):
+        p = os.path.join(libdir, stem + ".dylib")
+        if os.path.exists(p): _libs.append(ctypes.CDLL(p, mode=ctypes.RTLD_GLOBAL))
+    if not _libs: raise ImportError("the GTK 2 libraries are not loaded in this process and COOT_GTK2_LIBDIR / COOT_PREFIX/lib does not contain them")
+
+# ------------------------------------------------------------------------------------------------ prototypes and calls
+_PROTOS = None
+def _protos():
+    global _PROTOS
+    if _PROTOS is None:
+        with open(os.path.join(_HERE, "_gtk2_protos.json")) as f: _PROTOS = json.load(f)
+    return _PROTOS
+
+_CT = {"i": c_int, "u": c_uint, "l": c_int64, "U": c_uint64, "d": c_double, "f": c_float, "b": c_bool, "h": c_short, "H": c_ushort, "c": c_byte, "C": c_ubyte}
+_NUMERIC = set(_CT)
+_CONSTS = None
+def consts():
+    global _CONSTS
+    if _CONSTS is None:
+        with open(os.path.join(_HERE, "_gtk2_consts.json")) as f: _CONSTS = json.load(f)
+    return _CONSTS
+_bound = {}
+def has_function(name): return name in _protos()
+def _bind(name):
+    b = _bound.get(name)
+    if b is not None: return b
+    _open_libs()
+    pr = _protos().get(name)
+    if pr is None: raise AttributeError("no C function '%s' in the GTK 2 prototype table" % name)
+    cf = None
+    for lib in _libs:
+        try: cf = getattr(lib, name); break
+        except AttributeError: continue
+    if cf is None: raise AttributeError("C function '%s' is not exported by the loaded GTK libraries" % name)
+    ret, args, variadic = pr[0], pr[1], pr[2]
+    def ct(code):
+        k = code.split(":")[0]
+        if k in _CT: return _CT[k]
+        if k == "s": return c_char_p
+        return c_void_p
+    cf.argtypes = [ct(a) for a in args]
+    r = ret.split(":")[0]
+    cf.restype = None if r == "v" else (c_char_p if r == "S" else (c_void_p if r in ("p", "A", "X") else _CT.get(r, c_void_p)))
+    b = (cf, ret, [a.split(":")[0] for a in args], variadic, args, pr[3] if len(pr) > 3 else [])
+    _bound[name] = b
+    return b
+
+def _conv_arg(code, a):
+    if code in _NUMERIC:
+        if code in ("d", "f"): return float(a)
+        if code == "b": return bool(a)
+        return int(a)
+    if code == "s":
+        if a is None: return None
+        if isinstance(a, str): return a.encode("utf-8")
+        if isinstance(a, (bytes, bytearray)): return bytes(a)
+        return str(a).encode("utf-8")
+    # pointer
+    if a is None: return None
+    p = getattr(a, "_ptr", None)
+    if p is not None: return p
+    if isinstance(a, (Structure, ctypes.Array)): return addressof(a)
+    if isinstance(a, ctypes._CFuncPtr): return cast(a, c_void_p).value
+    if isinstance(a, c_void_p): return a.value
+    return a
+
+def free(ptr):
+    if ptr: call("g_free", ptr)
+
+class GError(Exception):
+    pass
+# PyGTK defaults that differ from "NULL / 0" for omitted trailing arguments: function -> {argument index: value}
+DEFAULTS = {
+    "gtk_text_buffer_get_text": {3: True}, "gdk_colormap_alloc_color": {3: True}, "gtk_box_pack_start": {2: True, 3: True}, "gtk_box_pack_end": {2: True, 3: True},
+    "gtk_cell_layout_pack_start": {2: True}, "gtk_cell_layout_pack_end": {2: True}, "gtk_main_iteration_do": {0: True},
+}
+def _default_for(name, i, code, pname):
+    d = DEFAULTS.get(name)
+    if d is not None and i in d: return d[i]
+    if pname in ("len", "length", "n_bytes", "max_len", "text_length", "n_chars", "len_bytes"): return -1
+    return None if code in ("s", "p") else 0
+
+def call(name, *args):
+    """Call a C function from the prototype table with Python arguments; returns a Python value (str for strings, int/None for pointers).
+    Omitted trailing arguments become NULL/0 (or the PyGTK default); a trailing GError** is hidden and raised as GError."""
+    cf, ret, argc, variadic, full, pnames = _bind(name)
+    gerr = None
+    if len(args) == len(argc) - 1 and full[-1] == "p:GError":
+        gerr = c_void_p(); args = tuple(args) + (byref(gerr),)
+    if len(args) < len(argc):
+        args = tuple(args) + tuple(_default_for(name, i, argc[i], pnames[i] if i < len(pnames) else "") for i in range(len(args), len(argc)))
+    if len(args) > len(argc):
+        raise TypeError("%s takes %d arguments (%d given)%s" % (name, len(argc), len(args), "; variadic C functions cannot be called with extra arguments here" if variadic else ""))
+    r = cf(*[_conv_arg(c, a) for c, a in zip(argc, args)])
+    if gerr is not None and gerr.value:
+        mp = c_void_p.from_address(gerr.value + 8).value          # struct GError { GQuark domain; gint code; gchar *message; }
+        msg = ctypes.string_at(mp).decode("utf-8", "replace") if mp else "GError"
+        _bind("g_error_free")[0](gerr.value)
+        raise GError(msg)
+    k = ret.split(":")[0]
+    if k == "S": return r.decode("utf-8", "replace") if r is not None else None
+    if k == "A":
+        if not r: return None
+        s = ctypes.string_at(r).decode("utf-8", "replace"); free(r); return s
+    return r
+
+# ------------------------------------------------------------------------------------------------ GType helpers
+G_TYPE_CHAR, G_TYPE_UCHAR, G_TYPE_BOOLEAN, G_TYPE_INT, G_TYPE_UINT, G_TYPE_LONG, G_TYPE_ULONG, G_TYPE_INT64, G_TYPE_UINT64 = 12, 16, 20, 24, 28, 32, 36, 40, 44
+G_TYPE_ENUM, G_TYPE_FLAGS, G_TYPE_FLOAT, G_TYPE_DOUBLE, G_TYPE_STRING, G_TYPE_POINTER, G_TYPE_BOXED, G_TYPE_PARAM, G_TYPE_OBJECT = 48, 52, 56, 60, 64, 68, 72, 76, 80
+_tname_cache = {}
+def type_name(gtype):
+    n = _tname_cache.get(gtype)
+    if n is None:
+        n = call("g_type_name", gtype) or ""; _tname_cache[gtype] = n
+    return n
+def type_from_name(name): return call("g_type_from_name", name)
+def instance_gtype(ptr):
+    klass = c_void_p.from_address(ptr).value                    # GTypeInstance.g_class
+    return c_ulong.from_address(klass).value                    # GTypeClass.g_type
+def type_chain(gtype):
+    out = []
+    while gtype:
+        out.append(gtype); gtype = call("g_type_parent", gtype)
+    return out
+def type_interfaces(gtype):
+    n = c_uint(0)
+    p = call("g_type_interfaces", gtype, byref(n))
+    out = [c_ulong.from_address(p + 8 * i).value for i in range(n.value)] if p else []
+    if p: free(p)
+    return out
+_is_obj_cache = {}
+def is_gobject_typename(tn):
+    r = _is_obj_cache.get(tn)
+    if r is None:
+        gt = type_from_name(tn)
+        r = bool(gt) and bool(call("g_type_is_a", gt, G_TYPE_OBJECT)); _is_obj_cache[tn] = r
+    return r
+
+# C type name -> function-name prefix ("GtkHBox" -> "gtk_hbox", "GtkScrolledWindow" -> "gtk_scrolled_window")
+_prefix_cache = {}
+def prefix_for(tn, gtype):
+    if tn in _prefix_cache: return _prefix_cache[tn]
+    m = re.match(r"^(Gtk|Gdk|Pango|G)(.+)$", tn)
+    cands = []
+    if m:
+        mod, rest = m.group(1).lower(), m.group(2)
+        snake = re.sub(r"(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", "_", rest).lower()
+        cands = [mod + "_" + snake, mod + "_" + snake.replace("_", ""), mod + "_" + rest.lower()]
+        if mod == "g": cands.append("g_" + snake)
+    res = None
+    for c in cands:
+        gt = c + "_get_type"
+        if has_function(gt):
+            try:
+                if call(gt) == gtype: res = c; break
+            except Exception: pass
+    _prefix_cache[tn] = res
+    return res
+
+# ------------------------------------------------------------------------------------------------ GValue
+class GValue(Structure):
+    _fields_ = [("g_type", c_ulong), ("data", c_uint64 * 2)]
+def gvalue_init(gtype):
+    v = GValue(); call("g_value_init", v, gtype); return v
+def gvalue_set(v, py):
+    f = call("g_type_fundamental", v.g_type)
+    if f == G_TYPE_STRING: call("g_value_set_string", v, py)
+    elif f == G_TYPE_BOOLEAN: call("g_value_set_boolean", v, bool(py))
+    elif f == G_TYPE_INT: call("g_value_set_int", v, int(py))
+    elif f == G_TYPE_UINT: call("g_value_set_uint", v, int(py))
+    elif f == G_TYPE_LONG: call("g_value_set_long", v, int(py))
+    elif f == G_TYPE_ULONG: call("g_value_set_ulong", v, int(py))
+    elif f == G_TYPE_INT64: call("g_value_set_int64", v, int(py))
+    elif f == G_TYPE_UINT64: call("g_value_set_uint64", v, int(py))
+    elif f == G_TYPE_DOUBLE: call("g_value_set_double", v, float(py))
+    elif f == G_TYPE_FLOAT: call("g_value_set_float", v, float(py))
+    elif f == G_TYPE_ENUM: call("g_value_set_enum", v, int(py))
+    elif f == G_TYPE_FLAGS: call("g_value_set_flags", v, int(py))
+    elif f == G_TYPE_OBJECT: call("g_value_set_object", v, py)
+    elif f in (G_TYPE_BOXED,): call("g_value_set_boxed", v, py)
+    elif f == G_TYPE_POINTER: call("g_value_set_pointer", v, py)
+    elif f == G_TYPE_CHAR: call("g_value_set_char", v, int(py))
+    elif f == G_TYPE_UCHAR: call("g_value_set_uchar", v, int(py))
+    else: raise TypeError("cannot store a Python value in a GValue of type %s" % type_name(v.g_type))
+def gvalue_get(v):
+    f = call("g_type_fundamental", v.g_type)
+    if f == G_TYPE_STRING: return call("g_value_get_string", v)
+    if f == G_TYPE_BOOLEAN: return bool(call("g_value_get_boolean", v))
+    if f == G_TYPE_INT: return call("g_value_get_int", v)
+    if f == G_TYPE_UINT: return call("g_value_get_uint", v)
+    if f == G_TYPE_LONG: return call("g_value_get_long", v)
+    if f == G_TYPE_ULONG: return call("g_value_get_ulong", v)
+    if f == G_TYPE_INT64: return call("g_value_get_int64", v)
+    if f == G_TYPE_UINT64: return call("g_value_get_uint64", v)
+    if f == G_TYPE_DOUBLE: return call("g_value_get_double", v)
+    if f == G_TYPE_FLOAT: return call("g_value_get_float", v)
+    if f == G_TYPE_ENUM: return call("g_value_get_enum", v)
+    if f == G_TYPE_FLAGS: return call("g_value_get_flags", v)
+    if f == G_TYPE_OBJECT: return wrap(call("g_value_get_object", v))
+    if f in (G_TYPE_BOXED, G_TYPE_POINTER): return call("g_value_get_boxed" if f == G_TYPE_BOXED else "g_value_get_pointer", v)
+    if f == G_TYPE_CHAR: return call("g_value_get_char", v)
+    if f == G_TYPE_UCHAR: return call("g_value_get_uchar", v)
+    return None
+
+# ------------------------------------------------------------------------------------------------ the object model
+_classes = {}                       # C type name -> Python class (filled in by gtk/__init__.py, pango, gdk)
+_wrappers = weakref.WeakValueDictionary()
+def register_class(typename, cls): _classes[typename] = cls; cls._ctype_name = typename
+
+def _class_for(gtype):
+    for t in type_chain(gtype):
+        c = _classes.get(type_name(t))
+        if c is not None: return c
+    return _classes["GObject"]
+
+def wrap(ptr, take_ref=True):
+    """The Python wrapper of a GObject* (the same wrapper for the same object while one is alive)."""
+    if not ptr: return None
+    w = _wrappers.get(ptr)
+    if w is not None: return w
+    cls = _class_for(instance_gtype(ptr))
+    w = cls.__new__(cls)
+    w._ptr = ptr
+    call("g_object_ref_sink", ptr)                              # one reference for the wrapper (sinks a floating reference)
+    _wrappers[ptr] = w
+    return w
+
+_shutting_down = False
+import atexit
+atexit.register(lambda: globals().__setitem__("_shutting_down", True))
+
+class GObject(object):
+    """Base class of every wrapped GObject.  Unknown attributes are looked up as C methods of the object's type (and its ancestors), so
+    `button.set_label("x")` calls gtk_button_set_label(button, "x"), `box.get_children()` calls gtk_container_get_children, and so on."""
+    __slots__ = ("_ptr", "__weakref__", "_methods")
+    _ctype_name = "GObject"
+    def __init__(self, **props):
+        # direct construction of a plain GObject (rare): g_object_new_with_properties is not in 2.24, use g_object_newv with no properties
+        raise TypeError("%s cannot be created directly" % type(self).__name__)
+    def __del__(self):
+        p = getattr(self, "_ptr", None)
+        if p and not _shutting_down:
+            try: call("g_object_unref", p)
+            except Exception: pass
+    def __eq__(self, o): return isinstance(o, GObject) and o._ptr == self._ptr
+    def __ne__(self, o): return not self.__eq__(o)
+    def __hash__(self): return hash(self._ptr)
+    def __bool__(self): return True
+    def __repr__(self): return "<%s object at 0x%x>" % (type(self).__name__, self._ptr or 0)
+
+    # ---- method dispatch
+    def _find_method(self, name):
+        gt = instance_gtype(self._ptr)
+        key = (gt, name)
+        r = _method_cache.get(key)
+        if r is not None: return r or None
+        chain = type_chain(gt)
+        cands = chain + type_interfaces(gt)
+        for t in cands:
+            tn = type_name(t); pf = prefix_for(tn, t)
+            if not pf: continue
+            fn = pf + "_" + name
+            if has_function(fn):
+                a = _protos()[fn][1]
+                if a and a[0].startswith("p"):
+                    _method_cache[key] = fn; return fn
+        if any(type_name(t) == "GdkDrawable" for t in chain):         # gdk_draw_rectangle(drawable, ...) etc.
+            fn = "gdk_" + name
+            if has_function(fn): _method_cache[key] = fn; return fn
+        _method_cache[key] = ""
+        return None
+    def __getattr__(self, name):
+        if name.startswith("_") or name == "_methods":
+            raise AttributeError(name)
+        fn = self._find_method(name)
+        if fn is None:
+            if name.startswith("get_") or name.startswith("set_"):          # PyGTK also offers get_x()/set_x() through GObject properties
+                prop = name[4:].replace("_", "-")
+                if call("g_object_class_find_property", call("g_type_class_peek", instance_gtype(self._ptr)), prop):
+                    return (lambda: self.get_property(prop)) if name.startswith("get_") else (lambda v: self.set_property(prop, v))
+            raise AttributeError("'%s' object has no attribute '%s'" % (type(self).__name__, name))
+        return _make_method(self, fn)
+
+    # ---- properties
+    def _pspec(self, name):
+        ps = call("g_object_class_find_property", call("g_type_class_peek", instance_gtype(self._ptr)), name)
+        if not ps: raise TypeError("object of type %s has no property named '%s'" % (type(self).__name__, name))
+        return ps
+    def get_property(self, name):
+        ps = self._pspec(name)
+        # GParamSpec: GTypeInstance(8) + name(8) + flags(4,+4 pad) + value_type(8) -> value_type is at offset 24
+        gt = c_ulong.from_address(ps + 24).value
+        v = gvalue_init(gt); call("g_object_get_property", self._ptr, name, v)
+        try: return gvalue_get(v)
+        finally: call("g_value_unset", v)
+    def set_property(self, name, value):
+        ps = self._pspec(name)
+        gt = c_ulong.from_address(ps + 24).value
+        v = gvalue_init(gt)
+        try:
+            gvalue_set(v, value._ptr if isinstance(value, GObject) else value)
+            call("g_object_set_property", self._ptr, name, v)
+        finally: call("g_value_unset", v)
+    def set_properties(self, **props):
+        for k, v in props.items(): self.set_property(k.replace("_", "-"), v)
+
+    # ---- data
+    def set_data(self, key, value): _user_data.setdefault(self._ptr, {})[key] = value
+    def get_data(self, key): return _user_data.get(self._ptr, {}).get(key)
+
+    # ---- signals
+    def connect(self, name, func, *args): return connect_signal(self, name, func, args, after=False, swap=False)
+    def connect_after(self, name, func, *args): return connect_signal(self, name, func, args, after=True, swap=False)
+    def connect_object(self, name, func, obj, *args): return connect_signal(self, name, func, (obj,) + args, after=False, swap=True)
+    def disconnect(self, handler_id): call("g_signal_handler_disconnect", self._ptr, handler_id)
+    def handler_block(self, handler_id): call("g_signal_handler_block", self._ptr, handler_id)
+    def handler_unblock(self, handler_id): call("g_signal_handler_unblock", self._ptr, handler_id)
+    def stop_emission(self, name): call("g_signal_stop_emission_by_name", self._ptr, name)
+    emit_stop_by_name = stop_emission
+    def emit(self, name, *args): return emit_signal(self, name, args)
+    def freeze_notify(self): call("g_object_freeze_notify", self._ptr)
+    def thaw_notify(self): call("g_object_thaw_notify", self._ptr)
+
+_method_cache = {}
+_user_data = {}
+
+# ---- out parameters: C functions whose listed argument positions are filled in by the function (PyGTK returns them)
+_OUT_STRUCT = {"GtkTextIter": 128, "GtkTreeIter": 32, "GdkColor": 12, "GdkRectangle": 16, "GtkRequisition": 8, "GtkAllocation": 16}
+# function -> (indices of output arguments counted from the object, True if the C return value says whether the outputs are valid)
+OUT_PARAMS = {
+    "gtk_text_buffer_get_start_iter": ((1,), False), "gtk_text_buffer_get_end_iter": ((1,), False), "gtk_text_buffer_get_bounds": ((1, 2), False),
+    "gtk_text_buffer_get_iter_at_offset": ((1,), False), "gtk_text_buffer_get_iter_at_line": ((1,), False), "gtk_text_buffer_get_iter_at_mark": ((1,), False),
+    "gtk_text_buffer_get_iter_at_line_offset": ((1,), False), "gtk_text_buffer_get_selection_bounds": ((1, 2), True),
+    "gtk_combo_box_get_active_iter": ((1,), True), "gtk_tree_model_get_iter_first": ((1,), True),
+    "gtk_list_store_append": ((1,), False), "gtk_list_store_prepend": ((1,), False), "gtk_widget_size_request": ((1,), False),
+}
+_struct_classes = {}          # filled by gtk/__init__.py: "GtkTextIter" -> class (TextIter), ...
+# functions whose listed argument positions are plain int outputs (PyGTK returns them as a tuple)
+OUT_INTS = {"gtk_scrolled_window_get_policy": (1, 2), "gtk_window_get_size": (1, 2), "gtk_window_get_position": (1, 2), "gtk_widget_get_size_request": (1, 2)}
+
+def _make_method(obj, fn):
+    proto = _protos()[fn]
+    ret, argc = proto[0], proto[1]
+    outs = OUT_PARAMS.get(fn)
+    oints = OUT_INTS.get(fn)
+    def method(*args):
+        a = [obj] + list(args)
+        made = []
+        has_gerr = bool(argc) and argc[-1] == "p:GError"
+        nfull = len(argc) - (1 if has_gerr else 0)
+        if outs is not None and len(a) == nfull - len(outs[0]):       # the caller left out the output arguments: allocate them at their positions
+            for i in outs[0]:
+                tn = argc[i].split(":")[1] if ":" in argc[i] else ""
+                made.append(_struct_classes[tn]() if tn in _struct_classes else None)
+                a.insert(i, made[-1])
+        cints = []
+        if oints is not None and len(a) == nfull - len(oints):
+            for i in oints:
+                cints.append(c_int(0)); a.insert(i, byref(cints[-1]))
+        r = call(fn, *a)
+        if cints: return tuple(v.value for v in cints)
+        if outs is not None and made:
+            if outs[1] and not r: return None
+            return made[0] if len(made) == 1 else tuple(made)
+        k = ret.split(":")
+        if k[0] == "p" and len(k) > 1:
+            tn = k[1]
+            if tn == "GList": return glist_to_list(r, fn)
+            if tn == "GSList": return gslist_to_list(r)
+            if r and is_gobject_typename(tn): return wrap(r)
+        return r
+    method.__name__ = fn
+    return method
+
+def gslist_to_list(ptr):
+    """GSList* of GObjects -> Python list (the list is owned by its container: not freed)."""
+    out = []; p = ptr
+    while p:
+        data = c_void_p.from_address(p).value
+        out.append(wrap(data) if data else None); p = c_void_p.from_address(p + 8).value
+    return out
+
+def glist_to_list(ptr, fn=""):
+    """GList* -> Python list.  Widgets are wrapped; the list itself is freed (get_children() returns a newly allocated list)."""
+    out = []
+    p = ptr
+    while p:
+        data = c_void_p.from_address(p).value
+        out.append(wrap(data) if data else None)
+        p = c_void_p.from_address(p + 8).value
+    if ptr and fn in ("gtk_container_get_children", "gtk_toolbar_get_children", "gtk_menu_shell_get_children"): call("g_list_free", ptr)
+    return out
+
+# ------------------------------------------------------------------------------------------------ signals
+_HANDLERS = {}                      # key -> (cfunc, callback info)   (kept until GTK reports the closure is gone)
+CALLBACK_ERRORS = []                # (signal name, traceback text) of every exception raised inside a Python signal handler (tests read this)
+_next_key = [1]
+_NOTIFY_T = CFUNCTYPE(None, c_void_p, c_void_p)
+def _notify(data, closure):
+    _HANDLERS.pop(data, None)
+_NOTIFY = _NOTIFY_T(_notify)
+
+class Event(object):
+    """A GdkEvent as seen by Python: the common fields, plus those of key / button / motion / expose / scroll events."""
+    def __init__(self, ptr):
+        self._ptr = ptr
+        self.type = c_int.from_address(ptr).value
+        self.window = c_void_p.from_address(ptr + 8).value
+        t = self.type
+        if t in (8, 9):                                                  # GDK_KEY_PRESS, GDK_KEY_RELEASE
+            self.time = c_uint.from_address(ptr + 20).value; self.state = c_uint.from_address(ptr + 24).value
+            self.keyval = c_uint.from_address(ptr + 28).value
+            s = c_void_p.from_address(ptr + 40).value; self.string = ctypes.string_at(s).decode("utf-8", "replace") if s else ""
+        elif t in (4, 5, 6, 7):                                          # BUTTON_PRESS, 2BUTTON, 3BUTTON, BUTTON_RELEASE
+            self.time = c_uint.from_address(ptr + 20).value; self.x = c_double.from_address(ptr + 24).value; self.y = c_double.from_address(ptr + 32).value
+            self.state = c_uint.from_address(ptr + 48).value; self.button = c_uint.from_address(ptr + 52).value
+        elif t == 3:                                                     # MOTION_NOTIFY
+            self.time = c_uint.from_address(ptr + 20).value; self.x = c_double.from_address(ptr + 24).value; self.y = c_double.from_address(ptr + 32).value
+            self.state = c_uint.from_address(ptr + 48).value
+        elif t == 2:                                                     # EXPOSE
+            self.area = tuple(c_int.from_address(ptr + 20 + 4 * i).value for i in range(4))
+    def get_coords(self): return (getattr(self, "x", 0.0), getattr(self, "y", 0.0))
+
+def _arg_to_py(gtype, raw):
+    """Convert one raw ctypes signal argument to Python."""
+    f = call("g_type_fundamental", gtype)
+    if f == G_TYPE_OBJECT: return wrap(raw) if raw else None
+    if f == G_TYPE_BOXED:
+        if type_name(gtype) == "GdkEvent": return Event(raw) if raw else None
+        return raw
+    if f == G_TYPE_STRING: return ctypes.string_at(raw).decode("utf-8", "replace") if raw else None
+    if f == G_TYPE_BOOLEAN: return bool(raw)
+    return raw
+
+class SignalQuery(Structure):
+    _fields_ = [("signal_id", c_uint), ("signal_name", c_char_p), ("itype", c_ulong), ("signal_flags", c_int), ("return_type", c_ulong),
+                ("n_params", c_uint), ("param_types", c_void_p)]
+
+def _signal_info(obj, name):
+    gt = instance_gtype(obj._ptr)
+    sid = call("g_signal_lookup", name, gt)
+    if not sid: raise TypeError("%s: unknown signal name '%s'" % (type(obj).__name__, name))
+    q = SignalQuery(); call("g_signal_query", sid, q)
+    params = [c_ulong.from_address(q.param_types + 8 * i).value & ~1 for i in range(q.n_params)]     # (G_SIGNAL_TYPE_STATIC_SCOPE bit)
+    return sid, q.return_type, params
+
+_CT_FOR_FUND = {G_TYPE_BOOLEAN: c_int, G_TYPE_INT: c_int, G_TYPE_UINT: c_uint, G_TYPE_ENUM: c_int, G_TYPE_FLAGS: c_uint, G_TYPE_LONG: c_int64, G_TYPE_ULONG: c_uint64,
+                G_TYPE_INT64: c_int64, G_TYPE_UINT64: c_uint64, G_TYPE_DOUBLE: c_double, G_TYPE_FLOAT: c_float, G_TYPE_CHAR: c_byte, G_TYPE_UCHAR: c_ubyte}
+def connect_signal(obj, name, func, user_args, after=False, swap=False):
+    if not callable(func): raise TypeError("callback is not callable: %r" % (func,))
+    name = name.replace("_", "-") if "::" not in name and call("g_signal_lookup", name, instance_gtype(obj._ptr)) == 0 else name
+    sid, rtype, params = _signal_info(obj, name)
+    rf = call("g_type_fundamental", rtype)
+    argcts = [_CT_FOR_FUND.get(call("g_type_fundamental", p), c_void_p) for p in params]
+    rct = None if rf == 4 else (c_int if rf in (G_TYPE_BOOLEAN, G_TYPE_INT, G_TYPE_ENUM) else (c_uint if rf in (G_TYPE_UINT, G_TYPE_FLAGS) else c_void_p))
+    key = _next_key[0]; _next_key[0] += 1
+    def tramp(*raw):
+        inst = raw[0]; vals = raw[1:1 + len(params)]
+        try:
+            w = wrap(inst)
+            pyargs = [_arg_to_py(p, v) for p, v in zip(params, vals)]
+            if swap: res = func(*(list(user_args) + pyargs + [w]))
+            else:    res = func(w, *(pyargs + list(user_args)))
+            if rct is None: return None
+            if rf == G_TYPE_BOOLEAN: return 1 if res else 0
+            return int(res or 0)
+        except SystemExit: raise
+        except BaseException:
+            CALLBACK_ERRORS.append((name, traceback.format_exc()))
+            traceback.print_exc()
+            return 0 if rct is not None else None
+    cft = CFUNCTYPE(rct, c_void_p, *argcts, c_void_p)
+    cf = cft(tramp)
+    _HANDLERS[key] = (cf, func, user_args)
+    # g_signal_connect_data is NOT variadic.
+    hid = call("g_signal_connect_data", obj._ptr, name, cast(cf, c_void_p).value, key, cast(_NOTIFY, c_void_p).value, 1 if after else 0)
+    return hid
+
+def emit_signal(obj, name, args):
+    sid, rtype, params = _signal_info(obj, name)
+    n = 1 + len(params)
+    vals = (GValue * n)()
+    call("g_value_init", vals[0], instance_gtype(obj._ptr)); call("g_value_set_object", vals[0], obj._ptr)
+    for i, (p, a) in enumerate(zip(params, args)):
+        call("g_value_init", vals[i + 1], p); gvalue_set(vals[i + 1], a._ptr if isinstance(a, GObject) else a)
+    ret = GValue()
+    if rtype and call("g_type_fundamental", rtype) != 4: call("g_value_init", ret, rtype); call("g_signal_emitv", vals, sid, 0, ret)
+    else: call("g_signal_emitv", vals, sid, 0, None)
+    for i in range(n): call("g_value_unset", vals[i])
+    if ret.g_type:
+        try: return gvalue_get(ret)
+        finally: call("g_value_unset", ret)
+    return None
+
+# ------------------------------------------------------------------------------------------------ main loop, timeouts, idles
+_SRC_T = CFUNCTYPE(c_int, c_void_p)
+_SOURCES = {}
+def _add_source(adder, interval, func, args):
+    holder = {}
+    def tramp(data):
+        try:
+            r = func(*args)
+        except BaseException:
+            CALLBACK_ERRORS.append(("source", traceback.format_exc())); traceback.print_exc(); r = False
+        if not r: _SOURCES.pop(holder.get("id"), None)
+        return 1 if r else 0
+    cf = _SRC_T(tramp)
+    sid = adder(cf, interval)
+    holder["id"] = sid
+    _SOURCES[sid] = cf
+    return sid
+def timeout_add(interval, func, *args): return _add_source(lambda cf, i: call("g_timeout_add", i, cast(cf, c_void_p).value, None), interval, func, args)
+def idle_add(func, *args): return _add_source(lambda cf, i: call("g_idle_add", cast(cf, c_void_p).value, None), 0, func, args)
+def source_remove(sid):
+    _SOURCES.pop(sid, None); return bool(call("g_source_remove", sid))
+
+
+def gslist_of_strings(ptr, free_strings=True):
+    out = []; p = ptr
+    while p:
+        data = c_void_p.from_address(p).value
+        out.append(ctypes.string_at(data).decode("utf-8", "replace") if data else None)
+        if free_strings and data: free(data)
+        p = c_void_p.from_address(p + 8).value
+    if ptr: call("g_slist_free", ptr)
+    return out
