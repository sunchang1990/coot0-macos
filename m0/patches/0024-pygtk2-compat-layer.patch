@@ -0,0 +1,375 @@
+"""gtk -- PyGTK 2 compatible subset on ctypes, for Coot 0.9.8.96's Python scripts (see _gtk2core.py).
+
+Classes with PyGTK-specific constructors or semantics are written out below; every other method of every GTK/GDK/GObject class is found by name in the
+C API (box.get_children() -> gtk_container_get_children, entry.set_text(s) -> gtk_entry_set_text, ...), with PyGTK conventions for output arguments
+(text iterators, GError, GList) handled in _gtk2core.
+"""
+import sys, ctypes
+from ctypes import c_int, c_uint, c_void_p, create_string_buffer, addressof, string_at
+import _gtk2core as _c
+from _gtk2core import (GObject as _GObject, call as _call, wrap as _wrap, register_class as _reg, consts as _consts, _wrappers, GError)
+from . import gdk, keysyms
+
+pygtk_version = (2, 24, 0)
+gtk_version = (2, 24, 33)
+ver = gtk_version
+for _k, _v in _consts().items():                       # WINDOW_TOPLEVEL, STOCK_YES, POLICY_AUTOMATIC, ... (names as in PyGTK: GTK_ prefix removed)
+    if _k.startswith("GTK_"): globals()[_k[4:]] = _v
+
+def _adopt(self, ptr):
+    """Make `self` the wrapper of a freshly created GObject (sinks its floating reference)."""
+    if not ptr: raise RuntimeError("could not create a %s" % type(self).__name__)
+    self._ptr = ptr; _call("g_object_ref_sink", ptr); _wrappers[ptr] = self
+
+class Object(_GObject): pass
+class Adjustment(Object):
+    def __init__(self, value=0.0, lower=0.0, upper=0.0, step_incr=0.0, page_incr=0.0, page_size=0.0):
+        _adopt(self, _call("gtk_adjustment_new", value, lower, upper, step_incr, page_incr, page_size))
+
+class Widget(Object):
+    def set_flags(self, flags):
+        if flags & CAN_DEFAULT: _call("gtk_widget_set_can_default", self, True)
+        if flags & CAN_FOCUS: _call("gtk_widget_set_can_focus", self, True)
+    def unset_flags(self, flags):
+        if flags & CAN_DEFAULT: _call("gtk_widget_set_can_default", self, False)
+        if flags & CAN_FOCUS: _call("gtk_widget_set_can_focus", self, False)
+    @property
+    def window(self): return _wrap(_call("gtk_widget_get_window", self))
+    @property
+    def style(self): return _wrap(_call("gtk_widget_get_style", self))
+    @property
+    def allocation(self):
+        r = _Rect(); _call("gtk_widget_get_allocation", self, r); return r
+    @property
+    def parent(self): return _wrap(_call("gtk_widget_get_parent", self))
+    def get_colormap(self): return _wrap(_call("gtk_widget_get_colormap", self))
+    def create_pango_layout(self, text=None): return _wrap(_call("gtk_widget_create_pango_layout", self, text))
+
+class Container(Widget): pass
+class Bin(Container): pass
+class Misc(Widget): pass
+
+class Box(Container):
+    def pack_start(self, child, expand=True, fill=True, padding=0): _call("gtk_box_pack_start", self, child, expand, fill, padding)
+    def pack_end(self, child, expand=True, fill=True, padding=0): _call("gtk_box_pack_end", self, child, expand, fill, padding)
+class HBox(Box):
+    def __init__(self, homogeneous=False, spacing=0): _adopt(self, _call("gtk_hbox_new", homogeneous, spacing))
+class VBox(Box):
+    def __init__(self, homogeneous=False, spacing=0): _adopt(self, _call("gtk_vbox_new", homogeneous, spacing))
+class HSeparator(Widget):
+    def __init__(self): _adopt(self, _call("gtk_hseparator_new"))
+class VSeparator(Widget):
+    def __init__(self): _adopt(self, _call("gtk_vseparator_new"))
+class Table(Container):
+    def __init__(self, rows=1, columns=1, homogeneous=False): _adopt(self, _call("gtk_table_new", rows, columns, homogeneous))
+    def attach(self, child, left_attach, right_attach, top_attach, bottom_attach, xoptions=EXPAND | FILL, yoptions=EXPAND | FILL, xpadding=0, ypadding=0):
+        _call("gtk_table_attach", self, child, left_attach, right_attach, top_attach, bottom_attach, xoptions, yoptions, xpadding, ypadding)
+class Frame(Bin):
+    def __init__(self, label=None): _adopt(self, _call("gtk_frame_new", label))
+class ScrolledWindow(Bin):
+    def __init__(self, hadjustment=None, vadjustment=None): _adopt(self, _call("gtk_scrolled_window_new", hadjustment, vadjustment))
+class Notebook(Container):
+    def __init__(self): _adopt(self, _call("gtk_notebook_new"))
+class DrawingArea(Widget):
+    def __init__(self): _adopt(self, _call("gtk_drawing_area_new"))
+
+class Window(Bin):
+    def __init__(self, type=WINDOW_TOPLEVEL): _adopt(self, _call("gtk_window_new", type))
+class Dialog(Window):
+    def __init__(self, title=None, parent=None, flags=0, buttons=None):
+        _adopt(self, _call("gtk_dialog_new"))
+        self._setup(title, parent, flags, buttons)
+    def _setup(self, title, parent, flags, buttons):
+        if title: _call("gtk_window_set_title", self, title)
+        if parent: _call("gtk_window_set_transient_for", self, parent)
+        if flags & DIALOG_MODAL: _call("gtk_window_set_modal", self, True)
+        if flags & DIALOG_DESTROY_WITH_PARENT: _call("gtk_window_set_destroy_with_parent", self, True)
+        if buttons:
+            for i in range(0, len(buttons) - 1, 2): _call("gtk_dialog_add_button", self, buttons[i], buttons[i + 1])   # (not the variadic gtk_dialog_new_with_buttons)
+    @property
+    def vbox(self): return _wrap(_call("gtk_dialog_get_content_area", self))
+    @property
+    def action_area(self): return _wrap(_call("gtk_dialog_get_action_area", self))
+class MessageDialog(Dialog):
+    def __init__(self, parent=None, flags=0, type=MESSAGE_INFO, buttons=BUTTONS_NONE, message_format=None):
+        _adopt(self, _call("gtk_message_dialog_new", parent, flags, type, buttons, None))        # (format = NULL: no variadic arguments follow)
+        if message_format is not None:
+            _call("gtk_message_dialog_set_markup", self, _call("g_markup_escape_text", message_format, -1))
+class FileChooserDialog(Dialog):
+    def __init__(self, title=None, parent=None, action=FILE_CHOOSER_ACTION_OPEN, buttons=None, backend=None):
+        _adopt(self, _call("gtk_file_chooser_dialog_new", title, parent, action, None))          # (first_button_text = NULL terminates the C varargs)
+        if buttons:
+            for i in range(0, len(buttons) - 1, 2): _call("gtk_dialog_add_button", self, buttons[i], buttons[i + 1])
+class FileSelection(FileChooserDialog):
+    """GtkFileSelection (deprecated, struct members only) emulated with a file chooser dialog; ok_button / cancel_button are its real buttons."""
+    def __init__(self, title=None):
+        FileChooserDialog.__init__(self, title, None, FILE_CHOOSER_ACTION_OPEN, (STOCK_CANCEL, RESPONSE_CANCEL, STOCK_OK, RESPONSE_OK))
+    @property
+    def ok_button(self): return _wrap(_call("gtk_dialog_get_widget_for_response", self, RESPONSE_OK))
+    @property
+    def cancel_button(self): return _wrap(_call("gtk_dialog_get_widget_for_response", self, RESPONSE_CANCEL))
+class Assistant(Window):
+    def __init__(self): _adopt(self, _call("gtk_assistant_new"))
+
+class Button(Bin):
+    def __init__(self, label=None, stock=None, use_underline=True):
+        if stock: p = _call("gtk_button_new_from_stock", stock)
+        elif label is None: p = _call("gtk_button_new")
+        else: p = _call("gtk_button_new_with_mnemonic" if use_underline else "gtk_button_new_with_label", label)
+        _adopt(self, p)
+class ToggleButton(Button):
+    def __init__(self, label=None, use_underline=True):
+        _adopt(self, _call("gtk_toggle_button_new") if label is None else _call("gtk_toggle_button_new_with_mnemonic" if use_underline else "gtk_toggle_button_new_with_label", label))
+class CheckButton(ToggleButton):
+    def __init__(self, label=None, use_underline=True):
+        _adopt(self, _call("gtk_check_button_new") if label is None else _call("gtk_check_button_new_with_mnemonic" if use_underline else "gtk_check_button_new_with_label", label))
+class RadioButton(CheckButton):
+    def __init__(self, group=None, label=None, use_underline=True):
+        if group is None: p = _call("gtk_radio_button_new_with_mnemonic", None, label) if label is not None else _call("gtk_radio_button_new", None)
+        else: p = _call("gtk_radio_button_new_with_mnemonic_from_widget", group, label) if label is not None else _call("gtk_radio_button_new_from_widget", group)
+        _adopt(self, p)
+class Label(Misc):
+    def __init__(self, str=None): _adopt(self, _call("gtk_label_new", str))
+class Image(Misc):
+    def __init__(self): _adopt(self, _call("gtk_image_new"))
+class Entry(Widget):
+    def __init__(self, max=0):
+        _adopt(self, _call("gtk_entry_new"))
+        if max: _call("gtk_entry_set_max_length", self, max)
+class SpinButton(Entry):
+    def __init__(self, adjustment=None, climb_rate=0.0, digits=0): _adopt(self, _call("gtk_spin_button_new", adjustment, climb_rate, digits))
+class ProgressBar(Widget):
+    def __init__(self): _adopt(self, _call("gtk_progress_bar_new"))
+class Range(Widget): pass
+class Scale(Range): pass
+class HScale(Scale):
+    def __init__(self, adjustment=None): _adopt(self, _call("gtk_hscale_new", adjustment))
+class VScale(Scale):
+    def __init__(self, adjustment=None): _adopt(self, _call("gtk_vscale_new", adjustment))
+
+class Tooltips(Object):
+    def __init__(self): _adopt(self, _call("gtk_tooltips_new"))
+
+# ---- menus and toolbars
+class MenuShell(Container): pass
+class Menu(MenuShell):
+    def __init__(self): _adopt(self, _call("gtk_menu_new"))
+class MenuBar(MenuShell):
+    def __init__(self): _adopt(self, _call("gtk_menu_bar_new"))
+class MenuItem(Bin):
+    def __init__(self, label=None, use_underline=True):
+        _adopt(self, _call("gtk_menu_item_new") if label is None else _call("gtk_menu_item_new_with_mnemonic" if use_underline else "gtk_menu_item_new_with_label", label))
+class SeparatorMenuItem(MenuItem):
+    def __init__(self): _adopt(self, _call("gtk_separator_menu_item_new"))
+class CheckMenuItem(MenuItem):
+    def __init__(self, label=None, use_underline=True):
+        _adopt(self, _call("gtk_check_menu_item_new") if label is None else _call("gtk_check_menu_item_new_with_mnemonic" if use_underline else "gtk_check_menu_item_new_with_label", label))
+class ImageMenuItem(MenuItem):
+    def __init__(self, stock_id=None, accel_group=None):
+        _adopt(self, _call("gtk_image_menu_item_new") if stock_id is None else _call("gtk_image_menu_item_new_from_stock", stock_id, accel_group))
+class RadioMenuItem(CheckMenuItem): pass
+class Statusbar(Container):
+    def __init__(self): _adopt(self, _call("gtk_statusbar_new"))
+class Toolbar(Container):
+    def __init__(self): _adopt(self, _call("gtk_toolbar_new"))
+class ToolItem(Bin):
+    def __init__(self): _adopt(self, _call("gtk_tool_item_new"))
+class SeparatorToolItem(ToolItem):
+    def __init__(self): _adopt(self, _call("gtk_separator_tool_item_new"))
+class ToolButton(ToolItem):
+    def __init__(self, icon_widget=None, label=None): _adopt(self, _call("gtk_tool_button_new", icon_widget, label))
+class ToggleToolButton(ToolButton):
+    def __init__(self): _adopt(self, _call("gtk_toggle_tool_button_new"))
+
+# ---- text
+class TextTag(_GObject):
+    def __init__(self, name=None): _adopt(self, _call("gtk_text_tag_new", name))
