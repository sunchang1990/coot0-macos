+"""coot_python -- the four widgets Coot's C++ hands to its Python scripts, as wrapped GTK objects.
+The native module `_coot_python_native` (src/coot_pythonmodule.cc) returns the raw GtkWidget pointers."""
+import _gtk2core as _c
+import _coot_python_native as _n
+def main_menubar(): return _c.wrap(_n.main_menubar())
+def main_statusbar(): return _c.wrap(_n.main_statusbar())
+def main_toolbar(): return _c.wrap(_n.main_toolbar())
+def main_hbox(): return _c.wrap(_n.main_hbox())
