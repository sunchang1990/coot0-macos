+import _gtk2core as _c
+from _gtk2core import GObject, call as _call, wrap as _wrap, register_class as _reg, consts as _consts
+
+for _k, _v in _consts().items():                       # CONTROL_MASK, RGB_DITHER_NONE, KEY_Up, ...
+    if _k.startswith("GDK_"): globals()[_k[4:]] = _v
+
+Event = _c.Event
+
+class Pixbuf(GObject):
+    def __init__(self, colorspace=0, has_alpha=False, bits_per_sample=8, width=1, height=1):
+        p = _call("gdk_pixbuf_new", colorspace, has_alpha, bits_per_sample, width, height)
+        self._ptr = p; _call("g_object_ref_sink", p); _c._wrappers[p] = self
