+"""gobject -- PyGTK 2 compatible subset on ctypes."""
+import _gtk2core as _c
+from _gtk2core import GObject, timeout_add, idle_add, source_remove, GError
+TYPE_NONE, TYPE_CHAR, TYPE_UCHAR, TYPE_BOOLEAN, TYPE_INT, TYPE_UINT, TYPE_LONG, TYPE_ULONG = 4, 12, 16, 20, 24, 28, 32, 36
+TYPE_INT64, TYPE_UINT64, TYPE_ENUM, TYPE_FLAGS, TYPE_FLOAT, TYPE_DOUBLE, TYPE_STRING, TYPE_POINTER, TYPE_BOXED, TYPE_PARAM, TYPE_OBJECT = 40, 44, 48, 52, 56, 60, 64, 68, 72, 76, 80
+PRIORITY_DEFAULT, PRIORITY_HIGH, PRIORITY_LOW, PRIORITY_DEFAULT_IDLE = 0, -100, 300, 200
+IO_IN, IO_OUT, IO_PRI, IO_ERR, IO_HUP = 1, 4, 2, 8, 16
+def type_name(gtype): return _c.type_name(gtype)
+def threads_init(): pass          # (Python threads and GTK: the GIL is held by the GTK main thread, as in Coot's other Python)
