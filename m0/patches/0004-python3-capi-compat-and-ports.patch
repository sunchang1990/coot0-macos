diff --git a/compat/coot-python3-compat.hh b/compat/coot-python3-compat.hh
new file mode 100644
index 0000000..c77ad4a
--- /dev/null
+++ b/compat/coot-python3-compat.hh
@@ -0,0 +1,64 @@
+// compat/coot-python3-compat.hh -- Python 2 C-API names used by Coot 0.9.x, mapped onto Python 3.
+//
+// Semantics (reviewed per name; see the M0 report):
+//  * PyString_* work on Python 3 "str" (unicode).  PyString_AsString also accepts "bytes" and,
+//    as in Python 2, returns NULL with a TypeError set for anything else.
+//  * PyString_FromString decodes UTF-8 with errors="replace", so a stray non-UTF-8 byte
+//    (e.g. Latin-1 in a PDB remark) gives a replacement character instead of a NULL result.
+//  * PyString_Check is true for str and bytes (Python 2 code passed byte strings freely).
+//  * PyInt_* map to PyLong_* (Python 3 has a single integer type).
+#ifndef COOT_PYTHON3_COMPAT_HH
+#define COOT_PYTHON3_COMPAT_HH
+
+#ifdef USE_PYTHON
+#include <Python.h>
+
+#if PY_MAJOR_VERSION >= 3
+
+#include <string.h>   // plain C files include this header too, so no <cstring>/const_cast here
+
+static inline PyObject *coot_py_str_from_cstring(const char *s) {
+   return PyUnicode_DecodeUTF8(s, (Py_ssize_t) strlen(s), "replace");
+}
+
+static inline char *coot_py_cstring_from_str(PyObject *o) {
+   if (PyUnicode_Check(o)) return (char *) PyUnicode_AsUTF8(o);  // NULL + exception on failure
+   if (PyBytes_Check(o))   return PyBytes_AsString(o);
+   PyErr_SetString(PyExc_TypeError, "expected str or bytes");
+   return NULL;
+}
+
+static inline int coot_py_is_string(PyObject *o) { return PyUnicode_Check(o) || PyBytes_Check(o); }
+
+// Python 3.11 deprecates PySys_SetArgv (needs wchar_t**) -- set sys.argv directly, as str objects.
+// (PySys_SetArgv also prepended the script directory to sys.path; Coot does not rely on that.)
+static inline void coot_PySys_SetArgv(int argc, char **argv) {
+   PyObject *list = PyList_New(0);
+   if (!list) return;
+   for (int i = 0; i < argc; i++) {
+      PyObject *s = PyUnicode_DecodeFSDefault(argv[i]);
+      if (s) { PyList_Append(list, s); Py_DECREF(s); }
+   }
+   PySys_SetObject("argv", list);
+   Py_DECREF(list);
+}
+
+#define PyString_FromString(s)   coot_py_str_from_cstring(s)
+#define PyString_AsString(o)     coot_py_cstring_from_str(o)
+#define PyString_Check(o)        coot_py_is_string(o)
+#define PyString_Format(f, a)    PyUnicode_Format((f), (a))
+#define PyString_FromFormat      PyUnicode_FromFormat
+
+#define PyInt_Check(o)           PyLong_Check(o)
+#define PyInt_AsLong(o)          PyLong_AsLong(o)
+#define PyInt_FromLong(l)        PyLong_FromLong(l)
+#define PyInt_FromSize_t(n)      PyLong_FromSize_t(n)
+#define PyInt_Type               PyLong_Type
+
+// Python 3 dropped the 2nd (end-pointer) argument of PyFloat_FromString
+#define PyFloat_FromString(s, pend) PyFloat_FromString(s)
+#define PySys_SetArgv(argc, argv)   coot_PySys_SetArgv((argc), (argv))
+
+#endif // PY_MAJOR_VERSION >= 3
+#endif // USE_PYTHON
+#endif // COOT_PYTHON3_COMPAT_HH
