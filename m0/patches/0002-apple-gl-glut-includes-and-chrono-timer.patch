diff --git a/src/coot-gl-timer.hh b/src/coot-gl-timer.hh
new file mode 100644
index 0000000..c9b3e2a
--- /dev/null
+++ b/src/coot-gl-timer.hh
@@ -0,0 +1,20 @@
+// coot-gl-timer.hh -- replacement for glutGet(GLUT_ELAPSED_TIME)
+//
+// On macOS, GLUT_ELAPSED_TIME returns INT_MAX when GLUT is initialised but not run
+// (measured on Apple Silicon / macOS 26), which breaks every timing use in Coot.
+// This returns milliseconds on a monotonic clock, measured from the first call,
+// so differences between two calls behave as they did with GLUT.
+#ifndef COOT_GL_TIMER_HH
+#define COOT_GL_TIMER_HH
+#include <chrono>
+
+namespace coot {
+   namespace gl_timer {
+      inline long elapsed_ms() {
+         static const std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+         return static_cast<long>(std::chrono::duration_cast<std::chrono::milliseconds>
+                                  (std::chrono::steady_clock::now() - t0).count());
+      }
+   }
+}
+#endif // COOT_GL_TIMER_HH
