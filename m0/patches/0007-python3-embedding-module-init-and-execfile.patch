diff --git a/src/c-interface.cc b/src/c-interface.cc
index d2a1972..4af8a2b 100644
--- a/src/c-interface.cc
+++ b/src/c-interface.cc
@@ -7150,9 +7150,18 @@ run_python_script(const char *filename_in) {
 #ifdef USE_PYTHON
 
    std::string s = coot::util::intelligent_debackslash(filename_in);
+#if PY_MAJOR_VERSION >= 3
+   // Python 3 has no execfile(); run the file in the __main__ namespace, as execfile() did.
+   std::string simple = "exec(compile(open(";
+   simple += single_quote(s);
+   simple += ", 'rb').read(), ";
+   simple += single_quote(s);
+   simple += ", 'exec'))";
+#else
    std::string simple = "execfile(";
    simple += single_quote(s);
    simple += ")";
+#endif
    std::cout << "Running python script " << s  << std::endl;
    PyRun_SimpleString(simple.c_str());
 
diff --git a/src/coot-setup-python.cc b/src/coot-setup-python.cc
index f7ddd3d..1bcaf87 100644
--- a/src/coot-setup-python.cc
+++ b/src/coot-setup-python.cc
@@ -59,13 +59,32 @@ void setup_python(int argc, char **argv) {
 #ifdef USE_PYMAC_INIT 
   PyMac_Initialize();
 #else  
+#if PY_MAJOR_VERSION >= 3
+  // Python 3: built-in modules must be registered before the interpreter is initialized.
+  // coot.py (SWIG output) does "import _coot", which then resolves to the compiled-in module.
+  PyImport_AppendInittab("_coot", &PyInit__coot);
+#endif
   Py_Initialize(); // otherwise it core dumps saying python
   // interpreter not initialized (or something).
   PySys_SetArgv(argc, argv);
 #endif     
 
+#if PY_MAJOR_VERSION >= 3
+  {
+     // same job as init_coot() under Python 2: make sure the SWIG module is initialized
+     // before running .coot.py, eh?
+     PyObject *swig_module = PyImport_ImportModule("_coot");
+     if (swig_module == NULL) {
+        std::cout << "ERROR:: could not initialize the _coot SWIG module" << std::endl;
+        PyErr_Print();
+     } else {
+        Py_DECREF(swig_module);
+     }
+  }
+#else
   init_coot(); // i.e. SWIG_init for python, best we do this before
                // running .coot.py, eh?
+#endif
 
   
   std::string home_directory = coot::get_home_dir();;
