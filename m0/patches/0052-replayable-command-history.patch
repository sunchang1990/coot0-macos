@@ -5031,3 +5031,15 @@ use_mogul = True
 if (not command_in_path_qm("mogul")):
     use_mogul = False
 
+
+# macOS port (build 35): the language of the command echo in the terminal.  Coot writes each command it runs as a line you can
+# paste and run again: in Python by default (as in Calculate > Scripting > Python...), or in Scheme.  The history files
+# 0-coot-history.py and 0-coot-history.scm are written in both languages either way.
+def coot0_set_command_echo(language):
+    """coot0_set_command_echo("python") or coot0_set_command_echo("scheme"); returns the language now in use"""
+    import os
+    lang = str(language).strip().lower()
+    if lang not in ("python", "scheme"):
+        raise ValueError('coot0_set_command_echo: use "python" or "scheme"')
+    os.environ["COOT_COMMAND_ECHO"] = lang
+    return lang
