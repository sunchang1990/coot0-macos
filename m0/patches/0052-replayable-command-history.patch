diff --git a/src/graphics-info-state.cc b/src/graphics-info-state.cc
index 8e61e3d..1af32e6 100644
--- a/src/graphics-info-state.cc
+++ b/src/graphics-info-state.cc
@@ -30,6 +30,8 @@
 #endif
 
 #include <fstream>
+#include <map>
+#include <cstring>
 #include <algorithm>
 
 #include <gtk/gtk.h>
@@ -1057,6 +1059,126 @@ graphics_info_t::add_history_command(const std::vector<std::string> &command_str
 // Being a maniac, I thought to write out the history in scm and py.
 // On reflection, I think I might be a nutter (200402xx?).
 //
+// macOS port (build 35): history and the terminal echo that can be replayed.
+// Coot records each command once (name + arguments as text) and writes it in Python or Scheme form.  0.9.8.96 derived the
+// name by swapping '-' and '_' only, so commands whose scripting name differs (calculate_maps_and_stats_py, *-scm, ...) or that
+// exist in one language only produced lines that fail when replayed.  Here the name is looked up in the running interpreter:
+//   Python: <name>, <name>_py (from a -scm/_scm or _py name: the base name first);   Scheme: <name>, <name>-scm (likewise)
+// A command with no function in that language is written as a comment that says so (and gives the other language's call),
+// so a history file replays without stopping.  Booleans are written True/False (Python) and #t/#f (Scheme).
+static bool coot0_python_has(const std::string &name) {
+#ifdef USE_PYTHON
+   if (! Py_IsInitialized()) return false;
+   PyGILState_STATE gs = PyGILState_Ensure();
+   bool r = false;
+   PyObject *m = PyImport_AddModule("__main__");                 // borrowed
+   if (m) {
+      PyObject *d = PyModule_GetDict(m);                        // borrowed
+      PyObject *f = d ? PyDict_GetItemString(d, name.c_str()) : NULL;   // borrowed
+      r = f && PyCallable_Check(f);
+   }
+   PyGILState_Release(gs);
+   return r;
+#else
+   return false;
+#endif
+}
+
+static bool coot0_language_ready(bool python) {   // commands logged at startup come before the interpreters are up
+#ifdef USE_PYTHON
+   if (python) return Py_IsInitialized();
+#endif
+#ifdef USE_GUILE
+   if (! python) return scm_initialized_p != 0;
+#endif
+   return false;
+}
+
+static bool coot0_scheme_has(const std::string &name) {
+#ifdef USE_GUILE
+   SCM module = scm_c_resolve_module("guile-user");
+   SCM var = scm_module_variable(module, scm_from_locale_symbol(name.c_str()));
+   if (scm_is_false(var)) return false;
+   if (scm_is_false(scm_variable_bound_p(var))) return false;
+   return scm_is_true(scm_procedure_p(scm_variable_ref(var)));
+#else
+   return false;
+#endif
+}
+
+static std::string coot0_base_command_name(const std::string &raw) {   // a-b_c-scm -> a_b_c  (language suffix removed)
+   std::string n = raw;
+   for (auto &c : n) if (c == '-') c = '_';
+   for (const char *suf : {"_scm", "_py"}) {
+      size_t l = strlen(suf);
+      if (n.size() > l && n.compare(n.size() - l, l, suf) == 0) { n = n.substr(0, n.size() - l); break; }
+   }
+   return n;
+}
+
+// the scripting name of a recorded command in one language, "" when there is none
+std::string coot0_resolve_command_name(const std::string &raw, bool python) {
+   static std::map<std::string, std::string> cache_py, cache_scm;     // positive answers only (startup loads functions late)
+   std::map<std::string, std::string> &cache = python ? cache_py : cache_scm;
+   auto it = cache.find(raw);
+   if (it != cache.end()) return it->second;
+   if (! coot0_language_ready(python)) {           // not up yet: Coot's own conversion (swap - and _), not remembered
+      std::string own = raw;
+      for (auto &c : own) { if (python && c == '-') c = '_'; if (! python && c == '_') c = '-'; }
+      return own;
+   }
+   std::string base = coot0_base_command_name(raw);
+   std::vector<std::string> cands;
+   if (python) {
+      std::string own = raw; for (auto &c : own) if (c == '-') c = '_';
+      cands = { own, base, base + "_py" };
+   } else {
+      std::string own = raw; for (auto &c : own) if (c == '_') c = '-';
+      std::string b = base; for (auto &c : b) if (c == '_') c = '-';
+      cands = { own, b, b + "-scm" };
+   }
+   for (const auto &c : cands) {
+      if (python ? coot0_python_has(c) : coot0_scheme_has(c)) { cache[raw] = c; return c; }
+   }
+   return "";
+}
+
+std::string coot0_history_line(const std::vector<std::string> &command_strings, bool python) {
+   if (command_strings.empty()) return "";
+#ifdef USE_GUILE
+   if (command_strings.size() == 2 && command_strings[0] == DIRECT_SCM_STRING) {
+      if (! python) return command_strings[1];
+      return "# " + command_strings[1] + "   -- a Scheme expression; not available as a Python command";
+   }
+#endif
