+# macOS port (build 15): Coot 0.9.8.96's refine_auto_range() looks the residue up by its " CA " atom (c-interface-refine.cc), so on RNA/DNA (and on
+# ligands) it refined nothing ("refine_auto_range: Can't get index for resno1"), and Stepped Refine centred the view on "CA", which nucleotides do not
+# have, so the view did not move either.  Residues without CA are now centred on C1' (else P, else their first atom) and refined as the zone
+# res-1 .. res+1 (the same range refine_auto_range uses), limited to the residues that exist.
+def stepped_refine_centre_atom(imol, chain_id, res_no, ins_code=""):
+    """Atom name to centre a residue on: CA, else C1', else P, else the first atom (None if the residue has no atoms)."""
+    names = []
+    try:
+        for atom in residue_info(imol, chain_id, res_no, ins_code) or []:
+            names.append(atom[0][0].strip())
+    except Exception:
+        return None
+    for n in ("CA", "C1'", "C1*", "P"):
+        if n in names:
+            return n
+    return names[0] if names else None
+
+def refine_auto_range_any(imol, chain_id, res_no, alt_conf):
+    """refine_auto_range() for any residue: protein residues (with CA) go to Coot's own function, others are refined as res-1 .. res+1."""
+    if stepped_refine_centre_atom(imol, chain_id, res_no) in (None, "CA"):
+        refine_auto_range(imol, chain_id, res_no, alt_conf)
+        return
+    lo = res_no - 1 if residue_exists_qm(imol, chain_id, res_no - 1, "") else res_no
+    hi = res_no + 1 if residue_exists_qm(imol, chain_id, res_no + 1, "") else res_no
+    refine_zone(imol, chain_id, lo, hi, alt_conf)
+
