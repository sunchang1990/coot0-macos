+# macOS port (build 15): File > Fetch PDB & Map using PDB-REDO.  PDB-REDO answers a missing file with HTTP 404 and a small HTML page, and Coot's
+# downloader saved that page under the data file's name: for entries that PDB-REDO only serves as mmCIF (most new ones, e.g. 9E5H) the "model"
+# was an HTML page (read error, map only) and the HTML "guided tour" was then run as a script.  Now every download is checked (an HTML page or an
+# empty file is not data and is removed), the model falls back to <id>_final.cif, the guided tour is only run if it is real, and a message says
+# what could not be fetched.
+def pdb_redo_download_ok(file_name, kind="text"):
+    """True if file_name is a real download of that kind, not a missing/empty file or an error page (PDB-REDO sends HTML for a missing
+    file of an entry and JSON {"error":"Not Found"} for a missing entry): kind "pdb" must start with PDB records, "cif" with data_,
+    "mtz" with 'MTZ ', anything else must not look like HTML/JSON/XML."""
+    try:
+        with open(file_name, "rb") as f:
+            head = f.read(4096)
+    except (IOError, OSError):
+        return False
+    h = head.lstrip()
+    if not h:
+        return False
+    if kind == "mtz":
+        return head[:4] == b"MTZ "
+    if kind == "pdb":
+        return h[:6].rstrip() in (b"HEADER", b"REMARK", b"CRYST1", b"ATOM", b"HETATM", b"MODEL", b"TITLE", b"COMPND", b"SOURCE", b"EXPDTA", b"AUTHOR", b"SCALE1", b"ORIGX1", b"KEYWDS", b"JRNL", b"SEQRES")
+    if kind == "cif":
+        return h.startswith(b"data_") or (h.startswith(b"#") and b"\ndata_" in h)
+    return not h[:1] in (b"<", b"{", b"[")
+
+def pdb_redo_fetch(url, file_name, kind="text"):
+    """Download url to file_name; returns True if a real file arrived (an HTML error page is removed again)."""
+    print("getting", url)
+    try:
+        net_get_url(url, file_name)
+    except Exception as e:
+        print("PDB-REDO: download of %s failed: %s" % (url, e))
+    if pdb_redo_download_ok(file_name, kind):
+        return True
+    print("PDB-REDO: %s is not available (missing, or an error page came back instead of the file)" % url)
+    try:
+        if os.path.exists(file_name):
+            os.remove(file_name)          # (the error page this download just wrote)
+    except OSError:
+        pass
+    return False
+
